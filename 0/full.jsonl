tandalone --format json --agent reviewer \"<audit_prompt>\"","+","+# Offline / Air-gapped code generation via local Ollama","+opencode run --standalone --format json --agent coder --model ollama/qwen2.5-coder:latest --auto \"<prompt>\"","+```","+*(Subagents MUST NOT write to the ledger; only the root orchestrator writes checkpoints).*"]}],"created":true},{"filePath":"C:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\.agents\\skills\\aikit\\projects.md","hunks":[{"oldStart":0,"oldLines":0,"newStart":1,"newLines":40,"lines":["+# AIKit Projects: Command Matrix","+","+Read this when the work is in a project under `projects/` (the binding rules are in `SKILL.md`).","+","+The user's software lives in its own project, never in AIKit's tree:","+```bash","+python aikit.py list                 # which projects exist","+python aikit.py new <name> --description \"<10-350 chars>\" [--topic <t>]... [--kind software|game|science]  # own repo + .aikit memory; auto-detects UI, generates model logo/social candidates (POLLINATIONS_API_KEY) or local fallback, writes media pending; --publish refuses until logo/social are reviewed and applied (ADR-243)","+python aikit.py attach <path>        # an existing folder: adds .aikit/ memory and an AIKit Integrated badge under its README title (uncommitted)","+python aikit.py status <name>        # its task, changes, latest decision and its gates","+python aikit.py check <name>         # its Phase 4: tests, stack gates, hygiene, guidelines, secret scan; exit 0 to commit; never pushes, add --push only when push delivery is authorized (PRINCIPLE-018 R4)","+python aikit.py guideline <name> \"<rule>\" --source user   # a project rule, below the principles","+python aikit.py publish <name> [--public] [--owner <org>] [--license auto]  # its own GitHub repo with the README description, the recorded AI-chosen topics and an AI-chosen license; needs a 10-350 char README paragraph; only when the user asks","+python aikit.py license <name> [--suggest [--js