call_count == 1 and store.pending() == []\n\n\ndef test_every_library_dispatch_site_stages_outbound_calls_first():","originalFile":"\"\"\"Outbound tools draft instead of sending; only the user's approval sends (IDEA-032).\"\"\"\n\nimport json\nimport re\nfrom pathlib import Path\nfrom unittest.mock import MagicMock\n\nimport pytest\nfrom fastapi import HTTPException\n\nimport modules.tools.outbound as outbound\nfrom modules.tools.node import ToolDispatcherExecutor\nfrom modules.tools.outbound import OutboundDrafts, SEND_PHRASE, send_draft, stage_if_outbound\n\nEMAIL = {\"to_email\": \"a@example.com\", \"subject\": \"Hi\", \"body\": \"Hello\"}\n\n\n@pytest.fixture\ndef store(tmp_path, monkeypatch):\n    drafts = OutboundDrafts(str(tmp_path / \"outbound_drafts.json\"))\n    monkeypatch.setattr(outbound, \"default_store\", lambda: drafts)\n    return drafts\n\n\ndef test_an_outbound_call_is_drafted_and_the_model_is_told_nothing_was_sent(store):\n    message = stage_if_outbound(\"SendEmail\", EMAIL)\n    assert \"NOT sent\" in message\n    [draft] = store.pending()\n    assert draft[\"tool\"] == \"SendEmail\" and draft[\"args\"] == EMAIL\n    assert draft[\"id\"] in message\n    assert stage_if_outbound(\"Calculator\", {\"expression\": \"1+1\"}) is None\n\n\ndef test_a_draft_sends_once_and_only_with_the_confirmation_phrase(store):\n    stage_if_outbound(\"SendEmail\", EMAIL)\n    draft_id = store.pending()[0][\"id\"]\n    runner = MagicMock(return_value={\"result\": \"Success: Email sent to a@example.com\"})\n    with pytest.raises(HTTPException):\n        send_draft(draft_id, \"yes\", runner=runner)\n    runner.assert_not_called()\n    result = send_draft(draft_id, SEND_PHRASE, runner=runner)\n    assert result[\"status\"] == \"sent\"\n    runner.assert_called_once_with(\"SendEmail\", EMAIL)\n    with pytest.raises(ValueError, match=\"not pending\"):\n        send_draft(draft_id, SEND_PHRASE, runner=runner)\n    assert runner.call_count == 1 and store.pending() == []\n\n\ndef test_an_unreadable_draft_store_fails_closed(tmp_path, monkeypatch):\n    path = tmp_path / \"outbound_drafts.json\"\n    path.write_text(\"{not json\", encoding=\"utf-8\")\n    monkeypatch.setattr(outbound, \"default_store\", lambda: OutboundDrafts(str(path)))\n    message = stage_if_outbound(\"SendEmail\", EMAIL)\n    assert message.startswith(\"Error:\") and \"not sent\" in message\n\n\nasync def test_the_tool_dispatcher_drafts_send_email_instead_of_running_it(store):\n    executor = ToolDispatcherExecutor()\n    executor._load_tools = MagicMock(return_value={\"SendEmail\": {\"enabled\": True}})\n    executor.sandbox = MagicMock()\n    call = {\"id\": \"c1\", \"function\": {\"name\": \"SendEmail\", \"arguments\": json.dumps(EMAIL)}}\n    result = await executor.receive({\"choices\": [{\"message\": {\"role\": \"assistant\", \"tool_calls\": [call]}}],\n                                     \"messages\": []})\n    executor.sandbox.execute.assert_not_called()\n    assert \"NOT sent\" in json.dumps(result)\n    assert len(store.pending()) == 1\n\n\ndef test_every_library_dispatch_site_stages_outbound_calls_first():\n    # A fifth dispatcher that runs library code without the check would reopen the gap.\n    root = Path(__file__).resolve().parent.parent\n    for rel in (\"modules/tools/node.py\", \"modules/agent_loop/node.py\"):\n        source = (root / rel).read_text(encoding=\"utf-8\")\n        runs = len(re.findall(r\"sandbox\\.execute,\", source))\n        assert runs > 0, rel\n        assert source.count(\"stage_if_outbound(\") == runs, rel\n","structuredPatch":[{"oldStart":66,"oldLines":6,"newStart":66,"newLines":27,"lines":["     assert len(store.pending()) == 1"," "," ","+def test_the_draft_routes_list_send_once_and_discard(store, monkeypatch):","+    from fastapi.testclient import TestClient","+    from main import app","+","+    sent = MagicMock(return_value={\"result\": \"Success: Email sent to a@example.com\"})","+    monkeypatch.setattr(outbound, \"run_library_tool\", sent)","+    stage_if_outbound(\"SendEmail\", EMAIL)","+    stage_if_outbound(\"SendEmail\", {**EMAIL, \"subject\": \"Second\"})","+    with TestClient(app) as client:","+        client.app.state.module_manager.enable_module(\"tools\")","+        listed = client.get(\"/tools/drafts\").json()","+        first, second = (d[\"id\"] for d in listed[\"drafts\"])","+        assert listed[\"send_phrase\"] == SEND_PHRASE","+        assert client.post(f\"/tools/drafts/{first}/send\").status_code == 400","+        assert client.post(f\"/tools/drafts/{first}/send\", params={\"confirm\": SEND_PHRASE}).json()[\"status\"] == \"sent\"","+        assert client.post(f\"/tools/drafts/{first}/send\", params={\"confirm\": SEND_PHRASE}).status_code == 409","+        assert client.post(f\"/tools/drafts/{second}/discard\").json()[\"status\"] == \"discarded\"","+        assert client.post(\"/tools/drafts/nope/discard\").status_code == 404","+    assert sent.call_count == 1 and store.pending() == []","+","+"," def test_every_library_dispatch_site_stages_outbound_calls_first():","     # A fifth dispatcher that runs library code without the check would reopen the gap.","     root = Path(__file__).resolve().parent.parent"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"ccfec257-08e9-449d-8455-7df38d2e4498","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-vscode","cwd":"C:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\projects\\neurocore","sessionId":"05aa96e5-db7a-4aed-bad4-f0f3cebd2787","version":"2.1.312","gitBranch":"main"}
