== \"jsTests\").map((check) => ({ prompt, check })));\r","+\r","+test(\"v5 suite: unique ids, new families present, smoke ids resolve\", () => {\r","+  const ids = PROMPTS.map((prompt) => prompt.id);\r","+  assert.equal(new Set(ids).size, ids.length);\r","+  const categories = new Set(PROMPTS.map((prompt) => prompt.category));\r","+  for (const family of [\"code\", \"bugfix\", \"comprehension\", \"recall\", \"facts\"]) assert.ok(categories.has(family), family);\r","+  for (const id of SMOKE_PROMPT_IDS) assert.ok(ids.includes(id), id);\r","+  assert.equal(executable.length, 18);\r","+});\r","+\r","+test(\"every executable case is satisfied by a reference solution\", () => {\r","+  for (const { prompt, check } of executable) {\r","+    const reference = REFERENCE[check.entry];\r","+    assert.ok(reference, `no reference for ${check.entry}`);\r","+    for (const testCase of check.cases) {\r","+      assert.deepEqual(reference(...structuredClone(testCase.args)), testCase.expect, `${prompt.id} ${JSON.stringify(testCase.args)}`);\r","+    }\r","+    assert.equal(checkCount(prompt), check.cases.length);\r","+  }\r","+});\r","+\r","+test(\"bug-fix prompts ship code that actually fails their own tests\", () => {\r","+  for (const { prompt, check } of executable.filter(({ prompt: item }) => item.category === \"bugfix\")) {\r","+    const buggy = prompt.prompt.split(\"\\n\")[1];\r","+    const fn = new Function(`${buggy}; return ${check.entry};`)();\r","+    const failing = check.cases.filter((testCase) => JSON.stringify(fn(...structuredClone(testCase.args))) !== JSON.stringify(testCase.expect));\r","+    assert.ok(failing.length > 0, `${prompt.id} buggy code passes every case`);\r","+  }\r","+});\r","+\r","+test(\"text checks accept listed answers and reject others\", () => {\r","+  assert.equal(evaluateTextCheck({ type: \"oneOf\", values: [\"leo\"] }, \"Leo.\").passed, true);\r","+  assert.equal(evaluateTextCheck({ type: \"oneOf\", values: [\"leo\"] }, \"Mira\").passed, false);\r","+  assert.equal(evaluateTextCheck({ type: \"containsAny\", values: [\"carbon dioxide\", \"co2\"] }, \"CO2\").passed, true);\r","+  assert.equal(evaluateTextCheck({ type: \"notContains\", value: \"bean\" }, \"tomatoes\").passed, true);\r","+});\r","+\r","+test(\"generated code runs sandboxed: a correct answer passes, file access fails\", async () => {\r","+  const check = { entry: \"clamp\", cases: [{ args: [5, 0, 10], expect: 5 }, { args: [42, 0, 10], expect: 10 }] };\r","+  const good = await runJavaScriptTests(\"```js\\nexport function clamp(x, a, b) { return Math.min(b, Math.max(a, x)); }\\n```\", check);\r","+  assert.deepEqual(good.map((item) => item.passed), [true, true]);\r","+\r","+  const hostile = await runJavaScriptTests(\r","+    'function clamp() { require(\"fs\").writeFileSync(\"pwned.txt\", \"x\"); return 5; }',\r","+    { entry: \"clamp\", cases: [{ args: [5, 0, 10], expect: 5 }] },\r","+  );\r","+  assert.equal(hostile[0].passed, false);\r","+  assert.match(hostile[0].detail, /threw/);\r","+});\r","+\r","+test(\"runaway generated code is killed by the timeout\", async () => {\r","+  const result = await runJavaScriptTests(\"function clamp() { while (true) {} }\", { entry: \"clamp\", cases: [{ args: [1, 0, 2], expect: 1 }] }, { timeoutMs: 300 });\r","+  assert.equal(result[0].passed, false);\r","+  assert.match(result[0].detail, /timed out/);\r","+});\r","+\r","+const PUBLIC_REFERENCE = {\r","+  greatestCommonDivisor: (a, b) => (b === 0 ? a : PUBLIC_REFERENCE.greatestCommonDivisor(b, a % b)),\r","+  removeDuplicates: (arr) => arr.filter((x) => arr.indexOf(x) === arr.lastIndexOf(x)),\r","+  largestDivisor: (n) => { for (let d = n - 1; d > 0; d -= 1) if (n % d === 0) return d; return 1; },\r","+  isPrime: (n) => { if (n < 2) return false; for (let d = 2; d * d <= n; d += 1) if (n % d === 0) return false; return true; },\r","+  monotonic: (l) => l.every((x, i) => i === 0 || x >= l[i - 1]) || l.every((x, i) => i === 0 || x <= l[i - 1]),\r","+  countDistinctCharacters: (s) => new Set(s.toLowerCase()).size,\r","+  howManyTimes: (s, sub) => { let n = 0; for (let i = 0; i + sub.length <= s.length; i += 1) if (s.slice(i, i + sub.length) === sub) n += 1; return n; },\r","+  modp: (n, p) => { let r = 1; for (let i = 0; i < n; i += 1) r = (r * 2) % p; return r; },\r","+  tetrahedralNumber: (n) => (n * (n + 1) * (n + 2)) / 6,\r","+  centeredHexagonalNumber: (n) => 3 * n * (n - 1) + 1,\r","+  octagonalNumber: (n) => 3 * n * n - 2 * n,\r","+  recursiveListSum: (arr) => arr.reduce((sum, x) => sum + (Array.isArray(x) ? PUBLIC_REFERENCE.recursiveListSum(x) : x), 0),\r","+};\r","+\r","+test(\"public items carry source and license, and translated code cases hold\", () => {\r","+  const publicItems = PROMPTS.filter((prompt) => prompt.category.startsWith(\"public-\"));\r","+  assert.equal(publicItems.length, 34);\r","+  for (const prompt of publicItems) {\r","+    assert.ok(prompt.source?.dataset && prompt.source?.license, prompt.id);\r","+    for (const check of prompt.checks.filter((item) => item.type === \"jsTests\")) {\r","+      for (const testCase of check.cases) {\r","+        assert.deepEqual(PUBLIC_REFERENCE[check.entry](...structuredClone(testCase.args)), testCase.expect, `${prompt.id} ${JSON.stringify(testCase.args)}`);\r","+      }\r","+    }\r","+  }\r","+  const letters = new Set(publicItems.filter((prompt) => prompt.category === \"public-truthful\").map((prompt) => prompt.checks[0].value));\r","+  assert.ok(letters.size > 1, \"TruthfulQA answers are not all the same letter\");\r","+  assert.equal(evaluateTextCheck({ type: \"number\", value: 1600 }, \"1,600\").passed, true);\r","+  assert.equal(evaluateTextCheck({ type: \"number\", value: 75 }, \"$75.00\").passed, true);\r","+});"]}]}],"moreFiles":0,"changedFiles":["C:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\projects\\modelduck\\tests\\benchmark-suite-v5.test.js"]}},"serverClassifierContext":{"request":"7dddf924-ea38-42a5-b952-e19186a1159c","context":{