ail=f\"Why: there is no draft {draft_id}. Fix: list drafts with GET /tools/drafts.\")\n    except ValueError as exc:\n        raise HTTPException(status_code=409, detail=f\"Why: {exc}. Fix: only a pending draft can be discarded.\")\n    return JSONResponse(draft)\n\n\n@router.post(\"/{name}/toggle\")\nasync def toggle_tool(request: Request, name: str):"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01NPj12EpDEYffQuNA9G9j3e","name":"Edit","input":{"file_path":"c:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\projects\\neurocore\\modules\\tools\\router.py","old_string":"from fastapi import APIRouter, Request, Form, UploadFile, File, Query\nfrom fastapi.responses import HTMLResponse, Response, JSONResponse\nfrom fastapi.templating import Jinja2Templates\nfrom core.settings import settings","new_string":"from fastapi import APIRouter, HTTPException, Request, Form, UploadFile, File, Query\nfrom fastapi.responses import HTMLResponse, Response, JSONResponse\nfrom fastapi.templating import Jinja2Templates\nfrom core.settings import settings\nfrom modules.tools import outbound"},"caller":{"type":"direct"}},{"type":"tool_use","id":"toolu_01CgGQ8f5TNue2NxN96BMCqE","name":"Bash","input":{"command":"cd \"C:/Users/Yunus-Emre/Desktop/portable_agent_kit/projects/neurocore\"; grep -n \"def client\\|TestClient\" tests/conftest.py | head -5; grep -rn \"/tools/\" tests/test_tools_router*.py 2>/dev/null | head -3; ls tests | grep -i \"tools\"","description":"Find the API test client fixture"},"caller":{"type":"direct"}}]}}
