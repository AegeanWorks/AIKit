, \"scripts/sync_principles.py\", \"--check\"]),\n59\t        (\"knowledge\", [sys.executable, \"scripts/update_knowledge_base.py\", \"--check\"]),\n60\t        (\"reachability\", [sys.executable, \"scripts/check_reachability.py\"]),\n61\t        (\"secrets\", [sys.executable, \"scripts/check_secrets.py\", \"--commits\", secret_range]),\n62\t        (\"dogfood\", [sys.executable, \"scripts/dogfood.py\"]),\n63\t    ]\n64\t\n65\t\n66\tdef scanned_range(repo: Path, ref: str, run: Runner) -> str:\n67\t    \"\"\"\n68\t    The commits this verification covers, as resolved SHAs: everything past the upstream when one\n69\t    resolves and is behind, otherwise this commit alone. Resolved, because the worktree is\n70\t    detached, where `@{u}` and `HEAD` mean something else or nothing.\n71\t\n72\t    A bare SHA is returned only for a root commit, because `git log -p <sha>` walks every commit\n73\t    reachable from it: handing one back whenever no upstream resolved scanned the whole history,\n74\t    which stays red forever over a key already revoked (ADR-133, ADR-149).\n75\t    \"\"\"\n76\t    head = run([\"git\", \"rev-parse\", ref], repo)[1].strip()\n77\t    code, upstream = run([\"git\", \"rev-parse\", f\"{ref}@{{u}}\"], repo)\n78\t    upstream = upstream.strip() if code == 0 else \"\"\n79\t    if upstream and upstream != head:\n80\t        return f\"{upstream}..{head}\"\n81\t    code, parent = run([\"git\", \"rev-parse\", f\"{ref}^\"], repo)\n82\t    parent = parent.strip() if code == 0 else \"\"\n83\t    return f\"{parent}..{head}\" if parent else head\n84\t\n85\t\n86\tdef recovery_fix(ref: str, resolved: str, repo: Path, run: Runner) -> str:\n87\t    \"\"\"\n88\t    The Fix line for a commit that fails on its own, chosen by where that commit is.\n89\t\n90\t    The undo PRINCIPLE-018 R5 names, `git reset --soft HEAD^`, fits only an unpushed HEAD. It used\n91\t    to be printed for every failing commit, so verifying an older one with --ref, or one already on\n92\t    the remote, told the user to undo a different commit or rewrite published history (ADR-186).\n93\t    \"\"\"\n94\t    target = run([\"git\", \"rev-parse\", ref], repo)[1].strip()\n95\t    # Published if the upstream has it, or - when there is no upstream, as after `git push origin\n96\t    # HEAD` without -u - if any remote-tracking branch does. Treating \"no upstream\" as \"unpushed\"\n97\t    # printed the reset advice for a commit already on the remote (ADR-188).\n98\t    upstream_has_it = run([\"git\", \"merge-base\", \"--is-ancestor\", target, \"HEAD@{u}\"], repo)[0] == 0\n99\t    remote_has_it = bool(run([\"git\", \"branch\", \"-r\", \"--contains\", target], repo)[1].strip())\n100\t    if upstream_has_it or remote_has_it:\n101\t        return (f\"Fix: {resolved} is already on the remote, so do not rewrite it: add what is \"\n102\t                \"missing in a new commit (PRINCIPLE-018 R5).\")\n103\t    if target != run([\"git\", \"rev-parse\", \"HEAD\"], repo)[1].strip():\n104\t        return (f\"Fix: {resolved} is not HEAD, so undoing HEAD would remove a different commit: \"\n105\t                \"add what is missing in a new commit (PRINCIPLE-018 R5).\")\n106\t    return (\"Fix: while the commit is unpushed, `git reset --soft HEAD^` (PRINCIPLE-018 R5), add \"\n107\t            \"what is missing, and commit again.\")\n108\t\n109\t\n110\tdef verify_commit(ref: str = \"HEAD\", repo: Path = ROOT_DIR,\n111\t                  runner: Optional[Runner] = None) -> Tuple[int, List[str]]:\n112\t    \"\"\"\n113\t    Run every gate against `ref` checked out on its own; returns (exit code, report lines).\n114\t    `runner` defaults to real subprocesses (PRINCIPLE-009 R4: the tests inject a double).\n115\t    \"\"\"\n116\t    run = runner or run_command\n117\t    report: List[str] = []\n118\t    code, resolved = run([\"git\", \"rev-parse\", \"--short\", ref], repo)\n119\t    if code != 0:\n120\t        return 1, [\"Error: no commit to verify.\",\n121\t                   f\"Why: '{ref}' does not name a commit in {repo}.\",\n122\t                   \"Fix: commit first, or pass --ref <commit>.\"]\n123\t    resolved = resolved.strip()\n124\t    secret_range = scanned_range(repo, ref, run)\n125\t\n126\t    tree = Path(tempfile.mkdtemp(prefix=\"aikit_verify_\"))\n127\t    worktree = tree / \"commit\"\n128\t    worktree_added = False\n129\t    try:\n130\t        code, output = run([\"git\", \"worktree\", \"add\", \"--detach\", str(worktree), ref], repo)\n131\t        if code != 0:\n132\t            return 1, [f\"Error: the commit {resolved} could not be checked out on its own.\",\n133\t                       f\"Why: `git worktree add` failed: {output[-300:]}\",\n134\t                       \"Fix: fix the git error above, then run this gate again.\"]\n135\t        worktree_added = True\n136\t        failures = []\n137\t        for name, argv in gate_commands(secret_range):\n138\t            code, output = run(argv, worktree)\n139\t            report.append(f\"[{'PASS' if code == 0 else 'FAIL'}] {name}\")\n140\t            if code != 0:\n141\t                failures.append(name)\n142\t                report += [f\"       {line}\" for line in\n143\t                           [l for l in output.splitlines() if l.strip()][-FAILURE_TAIL_LINES:]]\n144\t    finally:\n145\t        # The worktree is removed whether or not a gate failed, and its registration with it.\n146\t        if worktree_added:\n147\t            run([\"git\", \"worktree\", \"remove\", \"--force\", str(worktree)], repo)\n148\t        shutil.rmtree(tree, ignore_errors=True)\n149\t\n150\t    if failures:\n151\t        return 1, report + [\n152\t            f\"Error: commit {resolved} does not pass on its own: {', '.join(failures)}.\",\n153\t            \"Why: the pre-commit gates ran on the working tree, so the commit can hold less than \"\n154\t            \"what was tested (PRINCIPLE-018 R3, R7).\",\n155\t            recovery_fix(ref, resolved, repo, run),\n156\t        ]\n157\t    return 0, report + [f\"[OK] Commit {resolved} passes every gate on its own.\"]\n158\t\n159\t\n160\tKNOWN_FLAGS = {\"--ref\", \"--verbose\", \"-v\", \"--help\", \"-h\"}\n161\t\n162\tHELP_TEXT = \"\"\"AIKit Post-Commit Verification (PRINCIPLE-018 R7)\n163\t\n164\tUsage:\n165\t  python scripts/verify_commit.py [OPTIONS]\n166\t\n167\tChecks out a commit into a throwaway worktree and runs the whole gate set there, so a commit\n168\tthat holds less than the tree it was tested in is caught while it is still local.\n169\t\n170\tOptions:\n171\t  --ref <commit>   The commit to verify (default: HEAD)\n172\t  --verbose, -v    Print the resolved commit range scanned for secrets\n173\t  -h, --help       Show this help message and exit\n174\t\n175\tExit codes:\n176\t  0  the commit is green    1  a gate failed, or the commit could not be checked out    2  CLI argument misuse\n177\t\"\"\"\n178\t\n179\t\n180\tif __name__ == \"__main__\":\n181\t    # This CLI prints a project's own file paths, so a non-ASCII name must survive a Windows pipe,\n182\t    # whose default encoding is the console code page; `aikit check` reads gate output as UTF-8.\n183\t    # Here rather than at import, so a module that imports this one keeps its streams (ADR-189).\n184\t    if sys.platform == \"win32\":\n185\t        for stream in (sys.stdout, sys.stderr):\n186\t            try:\n187\t                stream.reconfigure(encoding=\"utf-8\", errors=\"replace\")\n188\t            except (AttributeError, ValueError, OSError):  # hygiene: allow encoding is cosmetic; a stream that cannot change keeps its own\n189\t                pass\n190\t    argv = sys.argv[1:]\n191\t    if \"-h\" in argv or \"--help\" in argv:\n192\t        print(HELP_TEXT, end=\"\")\n193\t        sys.exit(0)\n194\t    unknown = [a for i, a in enumerate(argv) if a.startswith(\"-\") and a not in KNOWN_FLAGS\n195\t               and (i == 0 or argv[i - 1] != \"--ref\")]\n196\t    if unknown:\n197\t        print(f\"[INVALID USAGE] Unrecognized option(s): {', '.join(unknown)}\", file=sys.stderr)\n198\t        print(f\"Why: this gate accepts only {', '.join(sorted(KNOWN_FLAGS))}.\", file=sys.stderr)\n199\t        print(\"Fix: run 'python scripts/verify_commit.py --help' to list valid options.\", file=sys.stderr)\n200\t        sys.exit(2)\n201\t    target = \"HEAD\"\n202\t    if \"--ref\" in argv:\n203\t        index = argv.index(\"--ref\")\n204\t        if index + 1 >= len(argv) or argv[index + 1].startswith(\"-\"):\n205\t            print(\"[INVALID USAGE] --ref requires a commit.\", file=sys.stderr)\n206\t            print(\"Why: there is no sensible default other than HEAD, which is already the default.\",\n207\t                  file=sys.stderr)\n208\t            print(\"Fix: pass '--ref <commit>', or omit it to verify HEAD.\", file=sys.stderr)\n209\t            sys.exit(2)\n210\t        target = argv[index + 1]\n211\t\n212\t    print(\"=\" * 58)\n213\t    print(\"POST-COMMIT VERIFICATION (PRINCIPLE-018 R7)\")\n214\t    print(\"=\" * 58)\n215\t    if \"--verbose\" in argv or \"-v\" in argv:\n216\t        print(f\"Secret scan range: {scanned_range(ROOT_DIR, target, run_command)}\")\n217\t    exit_code, lines = verify_commit(target)\n218\t    stream = sys.stdout if exit_code == 0 else sys.stderr\n219\t    for line in lines:"}]},"uuid":"ca457e3f-c091-4f1e-bda4-092002eb322e","timestamp":"2026-10-29T19:20:36.286Z","toolUseResult":{"type":"text","file":{"filePath":"c:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\scripts\\verify_commit.py","content":"  0 the commit is green    1 a gate failed or the worktree could not be made    2 CLI argument misuse\n\"\"\"\n\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\nfrom typing import Callable, List, Optional, Tuple\n\nROOT_DIR = Path(__file__).resolve().parent.parent\n# A whole gate set runs inside the worktree; past this the run is hung, not slow.\nGATE_TIMEOUT_SECONDS = 600\nGIT_TIMEOUT_SECONDS = 120\n# Lines of a failing gate's output shown (PRINCIPLE-012 R4, PRINCIPLE-015 R7).\nFAILURE_TAIL_LINES = 12\n\nRunner = Callable[[List[str], Path], Tuple[int, str]]\n\n\ndef run_command(argv: List[str], cwd: Path) -> Tuple[int, str]:\n    \"\"\"A command's exit code and combined output; -1 when it could not start or timed out.\"\"\"\n    try:\n        done = subprocess.run(argv, cwd=str(cwd), stdin=subprocess.DEVNULL, capture_output=True,\n                              text=True, encoding=\"utf-8\", errors=\"replace\",\n                              timeout=GATE_TIMEOUT_SECONDS)\n    except (OSError, subprocess.TimeoutExpired) as exc:\n        return -1, str(exc)\n    return done.returncode, (done.stdout + done.stderr).strip()\n\n\ndef gate_commands(secret_range: str) -> List[Tuple[str, List[str]]]:\n    \"\"\"\n    The gates PRINCIPLE-018 R3 names, as they run inside the worktree. The secret scan reads the\n    commit range rather than the tree, so it reports what the push would upload (ADR-145).\n    \"\"\"\n    return [\n        (\"tiers\", [sys.executable, \"scripts/check_test_budgets.py\"]),\n        (\"rules\", [sys.executable, \"scripts/sync_principles.py\", \"--check\"]),\n        (\"knowledge\", [sys.executable, \"scripts/update_knowledge_base.py\", \"--check\"]),\n        (\"reachability\", [sys.executable, \"scripts/check_reachability.py\"]),\n        (\"secrets\", [sys.executable, \"scripts/check_secrets.py\", \"--commits\", secret_range]),\n        (\"dogfood\", [sys.executable, \"scripts/dogfood.py\"]),\n    ]\n\n\ndef scanned_range(repo: Path, ref: str, run: Runner) -> str:\n    \"\"\"\n    The commits this verification covers, as resolved SHAs: everything past the upstream when one\n    resolves and is behind, otherwise this commit alone. Resolved, because the worktree is\n    detached, where `@{u}` and `HEAD` mean something else or nothing.\n\n    A bare SHA is returned only for a root commit, because `git log -p <sha>` walks every commit\n    reachable from it: handing one back whenever no upstream resolved scanned the whole history,\n    which stays red forever over a key already revoked (ADR-133, ADR-149).\n    \"\"\"\n    head = run([\"git\", \"rev-parse\", ref], repo)[1].strip()\n    code, upstream = run([\"git\", \"rev-parse\", f\"{ref}@{{u}}\"], repo)\n    upstream = upstream.strip() if code == 0 else \"\"\n    if upstream and upstream != head:\n        return f\"{upstream}..{head}\"\n    code, parent = run([\"git\", \"rev-parse\", f\"{ref}^\"], repo)\n    parent = parent.strip() if code == 0 else \"\"\n    return f\"{parent}..{head}\" if parent else head\n\n\ndef recovery_fix(ref: str, resolved: str, repo: Path, run: Runner) -> str:\n    \"\"\"\n    The Fix line for a commit that fails on its own, chosen by where that commit is.\n\n    The undo PRINCIPLE-018 R5 names, `git reset --soft HEAD^`, fits only an unpushed HEAD. It used\n    to be printed for every failing commit, so verifying an older one with --ref, or one already on\n    the remote, told the user to undo a different commit or rewrite published history (ADR-186).\n    \"\"\"\n    target = run([\"git\", \"rev-parse\", ref], repo)[1].strip()\n    # Published if the upstream has it, or - when there is no upstream, as after `git push origin\n    # HEAD` without -u - if any remote-tracking branch does. Treating \"no upstream\" as \"unpushed\"\n    # printed the reset advice for a commit already on the remote (ADR-188).\n    upstream_has_it = run([\"git\", \"merge-base\", \"--is-ancestor\", target, \"HEAD@{u}\"], repo)[0] == 0\n    remote_has_it = bool(run([\"git\", \"branch\", \"-r\", \"--contains\", target], repo)[1].strip())\n    if upstream_has_it or remote_has_it:\n        return (f\"Fix: {resolved} is already on the remote, so do not rewrite it: add what is \"\n                \"missing in a new commit (PRINCIPLE-018 R5).\")\n    if target != run([\"git\", \"rev-parse\", \"HEAD\"], repo)[1].strip():\n        return (f\"Fix: {resolved} is not HEAD, so undoing HEAD would remove a different commit: \"\n                \"add what is missing in a new commit (PRINCIPLE-018 R5).\")\n    return (\"Fix: while the commit is unpushed, `git reset --soft HEAD^` (PRINCIPLE-018 R5), add \"\n            \"what is missing, and commit again.\")\n\n\ndef verify_commit(ref: str = \"HEAD\", repo: Path = ROOT_DIR,\n                  runner: Optional[Runner] = None) -> Tuple[int, List[str]]:\n    \"\"\"\n    Run every gate against `ref` checked out on its own; returns (exit code, report lines).\n    `runner` defaults to real subprocesses (PRINCIPLE-009 R4: the tests inject a double).\n    \"\"\"\n    run = runner or run_command\n    report: List[str] = []\n    code, resolved = run([\"git\", \"rev-parse\", \"--short\", ref], repo)\n    if code != 0:\n        return 1, [\"Error: no commit to verify.\",\n                   f\"Why: '{ref}' does not name a commit in {repo}.\",\n                   \"Fix: commit first, or pass --ref <commit>.\"]\n    resolved = resolved.strip()\n    secret_range = scanned_range(repo, ref, run)\n\n    tree = Path(tempfile.mkdtemp(prefix=\"aikit_verify_\"))\n    worktree = tree / \"commit\"\n    worktree_added = False\n    try:\n        code, output = run([\"git\", \"worktree\", \"add\", \"--detach\", str(worktree), ref], repo)\n        if code != 0:\n            return 1, [f\"Error: the commit {resolved} could not be checked out on its own.\",\n                       f\"Why: `git worktree add` failed: {output[-300:]}\",\n                       \"Fix: fix the git error above, then run this gate again.\"]\n        worktree_added = True\n        failures = []\n        for name, argv in gate_commands(secret_range):\n            code, output = run(argv, worktree)\n            report.append(f\"[{'PASS' if code == 0 else 'FAIL'}] {name}\")\n            if code != 0:\n                failures.append(name)\n                report += [f\"       {line}\" for line in\n                           [l for l in output.splitlines() if l.strip()][-FAILURE_TAIL_LINES:]]\n    finally:\n        # The worktree is removed whether or not a gate failed, and its registration with it.\n        if worktree_added:\n            run([\"git\", \"worktree\", \"remove\", \"--force\", str(worktree)], repo)\n        shutil.rmtree(tree, ignore_errors=True)\n\n    if failures:\n        return 1, report + [\n            f\"Error: commit {resolved} does not pass on its own: {', '.join(failures)}.\",\n            \"Why: the pre-commit gates ran on the working tree, so the commit can hold less than \"\n            \"what was tested (PRINCIPLE-018 R3, R7).\",\n            recovery_fix(ref, resolved, repo, run),\n        ]\n    return 0, report + [f\"[OK] Commit {resolved} passes every gate on its own.\"]\n\n\nKNOWN_FLAGS = {\"--ref\", \"--verbose\", \"-v\", \"--help\", \"-h\"}\n\nHELP_TEXT = \"\"\"AIKit Post-Commit Verification (PRINCIPLE-018 R7)\n\nUsage:\n  python scripts/verify_commit.py [OPTIONS]\n\nChecks out a commit into a throwaway worktree and runs the whole gate set there, so a commit\nthat holds less than the tree it was tested in is caught while it is still local.\n\nOptions:\n  --ref <commit>   The commit to verify (default: HEAD)\n  --verbose, -v    Print the resolved commit range scanned for secrets\n  -h, --help       Show this help message and exit\n\nExit codes:\n  0  the commit is green    1  a gate failed, or the commit could not be checked out    2  CLI argument misuse\n\"\"\"\n\n\nif __name__ == \"__main__\":\n    # This CLI prints a project's own file paths, so a non-ASCII name must survive a Windows pipe,\n    # whose default encoding is the console code page; `aikit check` reads gate output as UTF-8.\n    # Here rather than at import, so a module that imports this one keeps its streams (ADR-189).\n    if sys.platform == \"win32\":\n        for stream in (sys.stdout, sys.stderr):\n            try:\n                stream.reconfigure(encoding=\"utf-8\", errors=\"replace\")\n            except (AttributeError, ValueError, OSError):  # hygiene: allow encoding is cosmetic; a stream that cannot change keeps its own\n                pass\n    argv = sys.argv[1:]\n    if \"-h\" in argv or \"--help\" in argv:\n        print(HELP_TEXT, end=\"\")\n        sys.exit(0)\n    unknown = [a for i, a in enumerate(argv) if a.startswith(\"-\") and a not in KNOWN_FLAGS\n               and (i == 0 or argv[i - 1] != \"--ref\")]\n    if unknown:\n        print(f\"[INVALID USAGE] Unrecognized option(s): {', '.join(unknown)}\", file=sys.stderr)\n        print(f\"Why: this gate accepts only {', '.join(sorted(KNOWN_FLAGS))}.\", file=sys.stderr)\n        print(\"Fix: run 'python scripts/verify_commit.py --help' to list valid options.\", file=sys.stderr)\n        sys.exit(2)\n    target = \"HEAD\"\n    if \"--ref\" in argv:\n        index = argv.index(\"--ref\")\n        if index + 1 >= len(argv) or argv[index + 1].startswith(\"-\"):\n            print(\"[INVALID USAGE] --ref requires a commit.\", file=sys.stderr)\n            print(\"Why: there is no sensible default other than HEAD, which is already the default.\",\n                  file=sys.stderr)\n            print(\"Fix: pass '--ref <commit>', or omit it to verify HEAD.\", file=sys.stderr)\n            sys.exit(2)\n        target = argv[index + 1]\n\n    print(\"=\" * 58)\n    print(\"POST-COMMIT VERIFICATION (PRINCIPLE-018 R7)\")\n    print(\"=\" * 58)\n    if \"--verbose\" in argv or \"-v\" in argv:\n        print(f\"Secret scan range: {scanned_range(ROOT_DIR, target, run_command)}\")\n    exit_code, lines = verify_commit(target)\n    stream = sys.stdout if exit_code == 0 else sys.stderr\n    for line in lines:","numLines":200,"startLine":20,"totalLines":223}},"sourceToolAssistantUUID":"c2f4affe-b700-46ed-bf81-04651d9eafdb","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-vscode","cwd":"C:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit","sessionId":"05aa