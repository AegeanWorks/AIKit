s (readable cross-origin?)\", () => call(h, \"GET\", \"/api/server-settings\")],\n  [\"POST /api/server-settings/api-keys (key readable?)\", () => call(h, \"POST\", \"/api/server-settings/api-keys\", { body: { label: \"x\" } })],\n  [\"DELETE /api/models/<id>\", () => call(h, \"DELETE\", `/api/models/${encodeURIComponent(h.modelId)}`)],\n]);\n\nawait scenario(\"C CORS on, auth ON, loopback socket, no key\", { enableCors: true, requireAuth: true }, (h) => [\n  [\"GET /v1/models no key (control: expect 401)\", () => call(h, \"GET\", \"/v1/models\")],\n  [\"GET /api/server-settings no key\", () => call(h, \"GET\", \"/api/server-settings\")],\n  [\"POST /api/server-settings/api-keys no key\", () => call(h, \"POST\", \"/api/server-settings/api-keys\", { body: { label: \"x\" } })],\n  [\"PUT /api/server-settings requireAuth:false no key\", () => call(h, \"PUT\", \"/api/server-settings\", { body: { enableCors: true, requireAuth: false } })],\n]);\n\nawait scenario(\"D LAN on only, auth ON, text/plain simple request\", { serveOnLocalNetwork: true, requireAuth: true }, (h) => [\n  [\"POST /api/conversations as text/plain from evil origin\", () => call(h, \"POST\", \"/api/conversations\", { body: { title: \"planted\" }, type: \"text/plain\" })],\n  [\"chat count after\", async () => String(h.chatStore.list().length)],\n]);\n\nawait scenario(\"E settings validation\", {}, (h) => [\n  [\"PUT LAN+CORS with auth off from the UI (no origin)\", () => call(h, \"PUT\", \"/api/server-settings\", { origin: null, body: { serveOnLocalNetwork: true, enableCors: true, requireAuth: false } })],\n]);\n\nfor (const fn of cleanups.reverse()) await fn();\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1188,"cache_read_input_tokens":80135,"output_tokens":2667,"output_tokens_details":{"thinking_tokens":79},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"s