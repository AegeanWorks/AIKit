ats.outputTokens, 6);\n  assert.equal(reloaded.list()[0].preview, \"They run on your computer.\");\n17:test(\"a conversation gets a title from its first user message and survives reload\", async (t) => {\n43:test(\"truncateToLastUser removes a failed or partial assistant reply\", async (t) => {\n58:test(\"delete and rename are durable\", async (t) => {\n74:test(\"a corrupt chat file becomes an empty, quarantined store\", async (t) => {","is_error":false}]},"uuid":"7d20b69d-9e4e-431e-a7d6-8f6744f6ee8c","timestamp":"2026-10-30T14:58:40.618Z","toolUseResult":{"stdout":"[OK] Checkpoint recorded: Task 'chat-archive', Phase 2 (in_progress) - [1/2] IDEA-1047: ChatStore archives least-recently-used chats past 200 to chats.archive.json instead of dropping them; load keeps all; restore on open; delete covers archive; [2/2] API archived list + sidebar Archived section, README, ADR\r\nimport assert from \"node:assert/strict\";\nimport { mkdtemp, readFile, rm, writeFile } from \"node:fs/promises\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport test from \"node:test\";\n\nimport { ChatStore } from \"../src/chat-store.js\";\n\nconst logger = { warn() {} };\n\nasync function tempFile(t) {\n  const directory = await mkdtemp(path.join(os.tmpdir(), \"modelduck-chats-\"));\n  t.after(() => rm(directory, { recursive: true, force: true }));\n  return path.join(directory, \"chats.json\");\n}\n\ntest(\"a conversation gets a title from its first user message and survives reload\", async (t) => {\n  const file = await tempFile(t);\n  const store = new ChatStore({ file, logger });\n  await store.load();\n\n  const conversation = store.create({ modelId: \"m1\", modelName: \"Duck 1B\" });\n  store.appendMessage(conversation.id, {\n    role: \"user\",\n    content: \"Explain **local** models in one paragraph, please.\",\n  });\n  store.appendMessage(conversation.id, {\n    role: \"assistant\",\n    content: \"They run on your computer.\",\n    stats: { outputTokens: 6 },\