{"parentUuid":"a5252cf4-f71b-4ee0-939e-2b8f06e9f4c5","isSidechain":false,"promptId":"417ceb17-a197-41b9-afc1-705bcfa65a6a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KBazjtZoCGS75v3STrZ1Z9","type":"tool_result","content":"\"\"\"One daily ceiling for everything the brain changes about itself.\nImprovement, configuration and learning each keep their own quota, but nothing answers \"how much\ndid the system change today, across all of them?\" or bounds automatic learning writes. This\nledger counts reserved units per kind and resets at UTC midnight; every reservation is persisted\nbefore the work starts so a crash cannot hide the spend (ADR-046).\n\"\"\"\nimport json\nimport logging\nimport os\nfrom dataclasses import dataclass, field\nfrom datetime import datetime, timezone\nfrom typing import Any, Dict, Optional\nfrom core.paths import data_path\nfrom .persistence import LedgerLock, atomic_write_json\nlogger = logging.getLogger(__name__)\nDEFAULT_CAPS: Dict[str, int] = {\n    \"candidate\": 50,\n    \"evaluation\": 50,\n    \"promotion\": 10,\n    \"config_change\": 20,\n    \"learning_write\": 500,\n    \"prompt_activation\": 20,\n}\nKINDS = tuple(DEFAULT_CAPS)\nclass SelfBudgetExceeded(ValueError):\n    \"\"\"Raised when the daily ceiling for one kind of self-modification is reached.\"\"\"\n    status_code = 429\n    def __init__(self, kind: str, cap: int, used: int):\n        self.kind = kind\n        self.cap = cap\n        self.used = used\n        super().__init__(\n            f\"daily self-modification budget exhausted for {kind}: {used} of {cap}. \"\n            \"Why: the system may not change itself without a daily ceiling. \"\n            \"Fix: wait until UTC midnight, or raise self_budget_caps in the brain config.\"\n        )\ndef _today() -> str:\n    return datetime.now(timezone.utc).date().isoformat()\ndef _validated_cap(raw: Dict[str, Any], kind: str) -> int:\n    try:\n        return max(1, int(raw.get(kind, DEFAULT_CAPS[kind])))\n    except (TypeError, ValueError):\n        logger.warning(\"Invalid self_budget_caps[%r]; using the default\", kind)\n        return DEFAULT_CAPS[kind]\n    async def consolidate_learning(self) -> Dict[str, Any]:\n        self.kernel.require_memory_write(\"learning consolidation\")\n        return self.learning.consolidate()\n\n    async def evaluate_learning_recall(self, top_k: int = 3) -> Dict[str, Any]:\n        return self.learning.evaluate_recall(top_k=top_k)\n\n    def suggest_learning(self, query: str, top_k: int = 3) -> Dict[str, Any]:\n        \"\"\"Skills worth reusing and past failures worth avoiding for one query.\"\"\"\n    async def run_evaluation(self, flow_id: Optional[str] = None) -> Dict[str, Any]:\n        result = await self.evaluation_runner.run(flow_id=flow_id)\n        self.kernel.record_evaluation(result)\n        try:\n            if float(result.get(\"pass_rate\", 0.0)) < 1.0:\n                self.kernel.record_component_error(\"evaluation\", \"evaluation below 100%\")\n            else:\n                self.kernel.record_component_recovery(\"evaluation\")\n        except (OSError, TypeError, ValueError) as exc:\n            logger.warning(\"Could not record the evaluation in the kernel: %s\", exc)\n        if self.kernel.can_write_memory():\n            for task in result.get(\"tasks\", []):\n                self.learning.record_outcome(\n                    action=f\"evaluation:{task.get('id', 'unknown')}\",\n                    input_data={\"task\": task.get(\"id\"), \"suite\": result.get(\"suite\")},\n                    output=task.get(\"output\", \"\"),\n                    success=bool(task.get(\"passed\")),\n                    error=task.get(\"error\"),\n                    latency_ms=float(task.get(\"latency_ms\", 0.0)),\n                    tags=[\"evaluation\", str(result.get(\"suite\", \"suite\"))],\n                )\n        self.eval_store.save_last(result)\n        async with self._state_lock:\n            # Do not turn a not-yet-captured self snapshot into a partial one; the next\n            # /brain/state call must still compose the full live snapshot.\n            if self.state.last_snapshot.get(\"timestamp\"):\n                self.state.last_snapshot.setdefault(\"evaluation\", {}).update({\n                    \"last_pass_rate\": result.get(\"pass_rate\"),\n                    \"last_flow_id\": result.get(\"flow_id\"),\n                    \"baseline_present\": bool(self.eval_store.load_baseline()),\n                })\n            self._save()\n        return result\n\n    async def promote_baseline(self, approved_by: str) -> Dict[str, Any]:\n        if not (isinstance(approved_by, str) and approved_by.strip()):\n            raise ValueError(\"approved_by is required to promote a baseline\")\n        last = self.eval_store.load_last()\n        if not last:\n            raise ValueError(\"run an evaluation before promoting a baseline\")\n        if not last.get(\"flow_id\"):\n            raise ValueError(\"baseline result does not identify a flow\")\n        if float(last.get(\"pass_rate\", 0.0)) < 1.0:","is_error":false}]},"uuid":"52cbefb3-c8f5-44a1-968d-8b6cc45cdb61","timestamp":"2026-10-29T21:03:07.442Z","toolUseResult":{"stdout":"\"\"\"One daily ceiling for everything the brain changes about itself.\nImprovement, configuration and learning each keep their own quota, but nothing answers \"how much\ndid the system change today, across all of them?\" or bounds automatic learning writes. This\nledger counts reserved units per kind and resets at UTC midnight; every reservation is persisted\nbefore the work starts so a crash cannot hide the spend (ADR-046).\n\"\"\"\nimport json\nimport logging\nimport os\nfrom dataclasses import dataclass, field\nfrom datetime import datetime, timezone\nfrom typing import Any, Dict, Optional\nfrom core.paths import data_path\nfrom .persistence import LedgerLock, atomic_write_json\nlogger = logging.getLogger(__name__)\nDEFAULT_CA