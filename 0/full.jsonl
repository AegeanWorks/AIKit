abort = new Error(\"Download canceled\");\n            abort.name = \"AbortError\";\n            throw abort;\n          }\n          await handle.write(chunk);\n          job.received += chunk.length;\n        }\n        await handle.sync();\n      } finally {\n        await handle.close().catch(() => {});\n      }\n\n      if (job.received !== job.size) {\n        throw new AppError(\"The download is incomplete\", {\n          code: \"download_incomplete\",\n          status: 502,\n          why: `Received ${formatBytes(job.received)} of ${formatBytes(job.size)} for ${job.name}.`,\n          fix: \"Click Download again to resume where it stopped.\",\n        });\n      }\n\n      await fs.promises.rename(partPath, finalPath);\n      job.status = \"complete\";\n      job.finishedAt = new Date().toISOString();\n      job.received = job.size;\n      job.total = job.size;\n    } catch (error) {\n      if (error?.name === \"AbortError\" || job.status === \"canceled\") {\n        job.status = \"canceled\";\n        job.finishedAt = new Date().toISOString();\n      } else {\n        job.status = \"error\";\n        job.finishedAt = new Date().toISOString();\n        job.error = {\n          message: error?.message || \"Download failed\",\n          why: error?.why || \"The file could not be downloaded.\",\n          fix: error?.fix || \"Check your internet connection, then retry the download.\",\n        };\n        this.#logger.warn?.(`[modelduck] ${job.error.message}`);\n      }\n    } finally {\n      job.controller = null;\n    }\n  }\n}\n","structuredPatch":[{"oldStart":227,"oldLines":6,"newStart":227,"newLines":7,"lines":["           }","           await handle.write(chunk);","           job.received += chunk.length;","+          touch();","         }","         await handle.sync();","       } finally {"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"82fb134b-2706-4f96-82a9-7e327625097c","permissionDecision":{