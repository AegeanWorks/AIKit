{"parentUuid":"77118a5b-30ea-4f78-ae21-dd44be79ca7f","isSidechain":false,"promptId":"417ceb17-a197-41b9-afc1-705bcfa65a6a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014iupqnNja72aqi4PxXhZSq","type":"tool_result","content":"The file c:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\projects\\neurocore\\modules\\knowledge_base\\node.py has been updated successfully."}]},"uuid":"2f4091eb-6e68-4642-9283-0735aaf482c7","timestamp":"2026-10-29T20:53:23.403Z","toolUseResult":{"filePath":"c:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\projects\\neurocore\\modules\\knowledge_base\\node.py","oldString":"from core.settings import settings\nfrom core.llm import LLMBridge\nfrom .backend import document_store","newString":"from core.settings import settings\nfrom core.llm import LLMBridge\nfrom modules.brain.guardrails import wrap_untrusted\nfrom .backend import document_store","originalFile":"from core.settings import settings\nfrom core.llm import LLMBridge\nfrom .backend import document_store\n\n# Module-level cached LLM bridge instance for KnowledgeQueryExecutor\n_llm_bridge_instance = None\n\n\ndef get_knowledge_llm_bridge():\n    \"\"\"Get or create a cached LLMBridge instance for knowledge base queries.\"\"\"\n    global _llm_bridge_instance\n    if _llm_bridge_instance is None:\n        from core.settings import settings\n        _llm_bridge_instance = LLMBridge(\n            base_url=settings.get(\"llm_api_url\"),\n            api_key=REDACTED,\n            embedding_base_url=settings.get(\"embedding_api_url\"),\n            embedding_model=settings.get(\"embedding_model\")\n        )\n    return _llm_bridge_instance\n\n\nclass KnowledgeQueryExecutor:\n    def __init__(self):\n        # Use shared cached LLMBridge instead of creating a new one each time\n        self.llm = get_knowledge_llm_bridge()\n\n    async def receive(self, input_data: dict, config: dict = None) -> dict:\n        if input_data is None: return None\n\n        # Bug fix: guard config against None\n        config = config or {}\n\n        query = \"\"\n        if isinstance(input_data, dict):\n            if \"messages\" in input_data and input_data[\"messages\"]:\n                # Use last user message\n                for msg in reversed(input_data[\"messages\"]):\n                    if msg[\"role\"] == \"user\":\n                        content = msg.get(\"content\", \"\")\n                        if isinstance(content, str):\n                            query = content\n                        elif isinstance(content, list): # Multimodal\n                             for part in content:\n                                 if part.get(\"type\") == \"text\":\n                                     query += part.get(\"text\", \"\") + \" \"\n                        break\n            elif \"content\" in input_data:\n                query = str(input_data[\"content\"])\n        elif isinstance(input_data, str):\n            query = input_data\n            \n        if not query:\n            return input_data\n\n        # Check if knowledge base is empty before processing\n        if document_store.get_total_documents() == 0:\n            return input_data\n\n        # Generate embedding for the query\n        embedding = await self.llm.get_embedding(query)\n\n        limit = int(config.get(\"limit\", 3))\n        \n        if embedding:\n            results = document_store.search_hybrid(query, embedding, limit)\n        else:\n            results = document_store.search_keyword(query, limit)\n        \n        # Each retrieved chunk is fenced as data: a document can carry instructions (IDEA-030).\n        context_str = \"\\n\\n\".join([\n            f\"--- Source: {r['source']} (Page {r.get('page', '?')}) ---\\n\"\n            + wrap_untrusted(r['content'], f\"document {r['source']}\")\n            for r in results])\n        \n        output = input_data.copy() if isinstance(input_data, dict) else {\"original\": input_data}\n        output[\"knowledge_context\"] = context_str\n        \n        # Don't inject into messages - let System Prompt handle the injection\n        # This prevents conflicts when multiple bridge nodes are used\n        \n        return output\n\n    async def send(self, processed_data: dict) -> dict:\n        return processed_data\n\nasync def get_executor_class(node_type_id: str):\n    if node_type_id == \"query_knowledge\":\n        return KnowledgeQueryExecutor\n    return None","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":6,"lines":[" from core.settings import settings"," from core.llm import LLMBridge","+from modules.brain.guardrails import wrap_untrusted"," from .backend import document_store"," "," # Module-level cached LLM bridge instance for KnowledgeQueryExecutor"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"77118a5b-30ea-4f78-ae21-dd44be79ca7f","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-vscode","cwd":"C:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\projects\\neurocore","sessionId":"05aa96e5-db7a-4aed-bad4-f0f3cebd2787","version":"2.1.312","gitBranch":"main"}
