] = []\n728\t    for line in block.splitlines():\n729\t        match = _TREE_LINE.match(line)\n730\t        if not match:\n731\t            continue\n732\t        name = match.group(2).split(\"<-\")[0].strip()\n733\t        stack = stack[:len(match.group(1)) // 4] + [name.rstrip(\"/\")]\n734\t        paths.append(\"/\".join(stack) + (\"/\" if name.endswith(\"/\") else \"\"))\n735\t    return paths\n736\t\n737\t\n738\tdef audit_readme(\n739\t    readme: str,\n740\t    tracked: Optional[List[str]],\n741\t    exists: Callable[[str], bool],\n742\t    script_source: Callable[[str], Optional[str]],\n743\t) -> List[str]:\n744\t    \"\"\"\n745\t    Every PRINCIPLE-005 rule a program can decide, as one error per violation. Pure: the caller\n746\t    supplies the tracked files (None when git is unavailable), a path test and a script reader.\n747\t    It replaces a test holding a fixed list of AIKit paths, which never noticed a new file\n748\t    missing from the tree, a dead path in it, or a documented flag that no script declares.\n749\t    \"\"\"\n750\t    errors: List[str] = []\n751\t    if len(readme) > README_MAX_CHARS:\n752\t        errors.append(f\"README.md has {len(readme):,} chars; the limit is {README_MAX_CHARS:,} (R1)\")\n753\t    errors += quick_reference_errors(readme)\n754\t    if README_PLACEHOLDER in readme:\n755\t        errors.append(f\"README.md still holds an unfilled '{README_PLACEHOLDER}' placeholder (R1); \"\n756\t                      \"only the project's own facts can replace it\")\n757\t\n758\t    tree = parse_readme_tree(readme)\n759\t    if not tree:\n760\t        errors.append(\"README.md has no ```text directory tree after \\\"What's Inside\\\" (R5)\")\n761\t    listed = {p.rstrip(\"/\") for p in tree}\n762\t    errors += [f\"README.md tree lists '{p}', which does not exist (R5)\" for p in tree if not exists(p.rstrip(\"/\"))]\n763\t    if tree and tracked is not None:\n764\t        # A tracked file deleted in the working copy is on its way out; the tree describes what\n765\t        # exists, the same rule the dead-path check above applies (ADR-214).\n766\t        tracked = [t for t in tracked if exists(t)]\n767\t        required = {t.split(\"/\")[0] for t in tracked}\n768\t        for directory in (p.rstrip(\"/\") for p in tree if p.endswith(\"/\") and any(q != p and q.startswith(p) for q in tree)):\n769\t            prefix = directory + \"/\"\n770\t            required |= {prefix + t[len(prefix):].split(\"/\")[0] for t in tracked if t.startswith(prefix)}\n771\t        errors += [f\"README.md tree omits tracked '{p}' (R5)\" for p in sorted(required - listed)]\n772\t\n773\t    for match in _SCRIPT_COMMAND.finditer(readme):\n774\t        script = match.group(1)\n775\t        source = script_source(script)\n776\t        if source is None:\n777\t            errors.append(f\"README.md runs '{script}', which does not exist (R3)\")\n778\t            continue\n779\t        errors += [f\"README.md passes {flag} to {script}, which does not declare it (R3)\"\n780\t                   for flag in _FLAG.findall(match.group(2)) if f'\"{flag}\"' not in source]\n781\t    # The `aikit.py` grammar lives in aikit_parser.py, apart from the commands, so `--help` can\n782\t    # load it alone (ADR-180); the subcommands are read where they are declared.\n783\t    documented = sorted(set(_AIKIT_COMMAND.findall(readme)))\n784\t    cli_source = script_source(\"scripts/aikit_parser.py\")\n785\t    if cli_source:\n786\t        known = set(_AIKIT_SUBCOMMAND.findall(cli_source))\n787\t        errors += [f\"README.md runs 'python aikit.py {cmd}', which the CLI does not declare (R3)\"\n788\t                   for cmd in documented if cmd not in known]\n789\t    elif documented and exists(\"aikit.py\"):\n790\t        # Where aikit.py lives, its grammar file must too: skipping here switched this check off\n791\t        # without a word whenever the file was renamed. An adopter project has no aikit.py of its\n792\t        # own and runs the commands from the AIKit folder, so it still skips (ADR-184).\n793\t        errors.append(\"README.md runs `python aikit.py` commands, but scripts/aikit_parser.py, \"\n794\t                      \"which declares them, does not exist (R3)\")\n795\t    for module in _UNITTEST_COMMAND.findall(readme):\n796\t        if not exists(module.replace(\".\", \"/\") + \".py\"):\n797\t            errors.append(f\"README.md runs test module '{module}', which does not exist (R3)\")\n798\t    return sorted(set(errors))\n799\t\n800\t\n801\tdef check_readme(root: Path = ROOT_DIR) -> List[str]:\n802\t    \"\"\"Run `audit_readme` on `root`, listing tracked files with git (bounded, PRINCIPLE-010 R3).\"\"\"\n803\t    readme_path = root / \"README.md\"\n804\t    if not readme_path.is_file():\n805\t        return [\"README.md does not exist (R1)\"]\n806\t    tracked: Optional[List[str]] = None\n807\t    try:\n808\t        listing = subprocess.run([\"git\", \"ls-files\", \"-z\"], cwd=root, capture_output=True,\n809\t                                 text=True, encoding=\"utf-8\", errors=\"replace\", timeout=10)\n810\t        if listing.returncode == 0:\n811\t            tracked = [p for p in listing.stdout.split(\"\\0\") if p]\n812\t    except (OSError, subprocess.SubprocessError):  # hygiene: allow git is optional here; the caller prints the WARN that follows\n813\t        pass\n814\t    if tracked is None:\n815\t        print(\"[WARN] git is unavailable, so README tree completeness was not checked (PRINCIPLE-005 R5).\")\n816\t\n817\t    def script_source(rel: str) -> Optional[str]:\n818\t        path = root / rel\n819\t        return path.read_text(encoding=\"utf-8\") if path.is_file() else None\n820\t\n821\t    return audit_readme(readme_path.read_text(encoding=\"utf-8\"), tracked,\n822\t                        lambda rel: (root / rel).exists(), script_source)\n823\t\n824\t\n825\tdef report_readme(errors: List[str]) -> bool:\n826\t    \"\"\"Print README findings with the remediation triad (PRINCIPLE-011 R6); True when clean.\"\"\"\n827\t    if not errors:\n828\t        print(\"[OK] README.md: size, labels, directory tree and documented commands verified (PRINCIPLE-005)\")\n829\t        return True\n830\t    print(f\"[FAIL] README.md drift ({len(errors)}):\")\n831\t    for error in errors[:20]:\n832\t        print(f\"   - {error}\")\n833\t    if len(errors) > 20:\n834\t        print(f\"   ... and {len(errors) - 20} more\")"}]},"uuid":"8a4413b6-ea64-487c-beb5-45b6fdb87d79","timestamp":"2026-10-29T18:55:48.466Z","toolUseResult":{"type":"text","file":{"filePath":"c:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\scripts\\update_knowledge_base.py","content":"        return [\"README.md has no heading containing 'Cold-Start Quick Reference' (R1)\"]\n    rest = readme[heading.end():]\n    following = re.search(rf\"^#{{1,{len(heading.group(1))}}} \", rest, re.M)\n    section = rest[:following.start()] if following else rest\n    errors: List[str] = []\n    prerequisites = re.search(r\"^- \\*\\*Runtime Prerequisites\\*\\*:([^\\n]*)\", section, re.M)\n    if not prerequisites:\n        errors.append(\"the Quick Reference has no line starting '- **Runtime Prerequisites**:' (R1)\")\n    elif not re.search(r\"\\d\", prerequisites.group(1)):\n        errors.append(\"'- **Runtime Prerequisites**:' names no minimum version (R1)\")\n    if not re.search(r\"\\*\\*Canonical Regression Shield Gate\\*\\*:[ \\t]*\\n[ \\t]*```[^\\n]*\\n[ \\t]*\\S\", section):\n        errors.append(\"the Quick Reference has no fenced command right after \"\n                      \"'**Canonical Regression Shield Gate**:' (R1)\")\n    return errors\n\n\ndef parse_readme_tree(readme: str) -> List[str]:\n    \"\"\"\n    Paths in the first ```text block after \"What's Inside\" (PRINCIPLE-005 R5), relative to the\n    repository root; a directory ends with '/'. The block's first line (the root) is skipped.\n    \"\"\"\n    heading = re.search(r\"^#+ .*What's Inside\", readme, re.M)  # a heading, never a mention in prose\n    fence = readme.find(\"```text\\n\", heading.end()) if heading else -1\n    if fence < 0:\n        return []\n    block = readme[fence + len(\"```text\\n\"):readme.find(\"```\", fence + len(\"```text\\n\"))]\n    paths: List[str] = []\n    stack: List[str] = []\n    for line in block.splitlines():\n        match = _TREE_LINE.match(line)\n        if not match:\n            continue\n        name = match.group(2).split(\"<-\")[0].strip()\n        stack = stack[:len(match.group(1)) // 4] + [name.rstrip(\"/\")]\n        paths.append(\"/\".join(stack) + (\"/\" if name.endswith(\"/\") else \"\"))\n    return paths\n\n\ndef audit_readme(\n    readme: str,\n    tracked: Optional[List[str]],\n    exists: Callable[[str], bool],\n    script_source: Callable[[str], Optional[str]],\n) -> List[str]:\n    \"\"\"\n    Every PRINCIPLE-005 rule a program can decide, as one error per violation. Pure: the caller\n    supplies the tracked files (None when git is unavailable), a path test and a script reader.\n    It replaces a test holding a fixed list of AIKit paths, which never noticed a new file\n    missing from the tree, a dead path in it, or a documented flag that no script declares.\n    \"\"\"\n    errors: List[str] = []\n    if len(readme) > README_MAX_CHARS:\n        errors.append(f\"README.md has {len(readme):,} chars; the limit is {README_MAX_CHARS:,} (R1)\")\n    errors += quick_reference_errors(readme)\n    if README_PLACEHOLDER in readme:\n        errors.append(f\"README.md still holds an unfilled '{README_PLACEHOLDER}' placeholder (R1); \"\n                      \"only the project's own facts can replace it\")\n\n    tree = parse_readme_tree(readme)\n    if not tree:\n        errors.append(\"README.md has no ```text directory tree after \\\"What's Inside\\\" (R5)\")\n    listed = {p.rstrip(\"/\") for p in tree}\n    errors += [f\"README.md tree lists '{p}', which does not exist (R5)\" for p in tree if not exists(p.rstrip(\"/\"))]\n    if tree and tracked is not None:\n        # A tracked file deleted in the working copy is on its way out; the tree describes what\n        # exists, the same rule the dead-path check above applies (ADR-214).\n        tracked = [t for t in tracked if exists(t)]\n        required = {t.split(\"/\")[0] for t in tracked}\n        for directory in (p.rstrip(\"/\") for p in tree if p.endswith(\"/\") and any(q != p and q.startswith(p) for q in tree)):\n            prefix = directory + \"/\"\n            required |= {prefix + t[len(prefix):].split(\"/\")[0] for t in tracked if t.startswith(prefix)}\n        errors += [f\"README.md tree omits tracked '{p}' (R5)\" for p in sorted(required - listed)]\n\n    for match in _SCRIPT_COMMAND.finditer(readme):\n        script = match.group(1)\n        source = script_source(script)\n        if source is None:\n            errors.append(f\"README.md runs '{script}', which does not exist (R3)\")\n            continue\n        errors += [f\"README.md passes {flag} to {script}, which does not declare it (R3)\"\n                   for flag in _FLAG.findall(match.group(2)) if f'\"{flag}\"' not in source]\n    # The `aikit.py` grammar lives in aikit_parser.py, apart from the commands, so `--help` can\n    # load it alone (ADR-180); the subcommands are read where they are declared.\n    documented = sorted(set(_AIKIT_COMMAND.findall(readme)))\n    cli_source = script_source(\"scripts/aikit_parser.py\")\n    if cli_source:\n        known = set(_AIKIT_SUBCOMMAND.findall(cli_source))\n        errors += [f\"README.md runs 'python aikit.py {cmd}', which the CLI does not declare (R3)\"\n                   for cmd in documented if cmd not in known]\n    elif documented and exists(\"aikit.py\"):\n        # Where aikit.py lives, its grammar file must too: skipping here switched this check off\n        # without a word whenever the file was renamed. An adopter project has no aikit.py of its\n        # own and runs the commands from the AIKit folder, so it still skips (ADR-184).\n        errors.append(\"README.md runs `python aikit.py` commands, but scripts/aikit_parser.py, \"\n                      \"which declares them, does not exist (R3)\")\n    for module in _UNITTEST_COMMAND.findall(readme):\n        if not exists(module.replace(\".\", \"/\") + \".py\"):\n            errors.append(f\"README.md runs test module '{module}', which does not exist (R3)\")\n    return sorted(set(errors))\n\n\ndef check_readme(root: Path = ROOT_DIR) -> List[str]:\n    \"\"\"Run `audit_readme` on `root`, listing tracked files with git (bounded, PRINCIPLE-010 R3).\"\"\"\n    readme_path = root / \"README.md\"\n    if not readme_path.is_file():\n        return [\"README.md does not exist (R1)\"]\n    tracked: Optional[List[str]] = None\n    try:\n        listing = subprocess.run([\"git\", \"ls-files\", \"-z\"], cwd=root, capture_output=True,\n                                 text=True, encoding=\"utf-8\", errors=\"replace\", timeout=10)\n        if listing.returncode == 0:\n            tracked = [p for p in listing.stdout.split(\"\\0\") if p]\n    except (OSError, subprocess.SubprocessError):  # hygiene: allow git is optional here; the caller prints the WARN that follows\n        pass\n    if tracked is None:\n        print(\"[WARN] git is unavailable, so README tree completeness was not checked (PRINCIPLE-005 R5).\")\n\n    def script_source(rel: str) -> Optional[str]:\n        path = root / rel\n        return path.read_text(encoding=\"utf-8\") if path.is_file() else None\n\n    return audit_readme(readme_path.read_text(encoding=\"utf-8\"), tracked,\n                        lambda rel: (root / rel).exists(), script_source)\n\n\ndef report_readme(errors: List[str]) -> bool:\n    \"\"\"Print README findings with the remediation triad (PRINCIPLE-011 R6); True when clean.\"\"\"\n    if not errors:\n        print(\"[OK] README.md: size, labels, directory tree and documented commands verified (PRINCIPLE-005)\")\n        return True\n    print(f\"[FAIL] README.md drift ({len(errors)}):\")\n    for error in errors[:20]:\n        print(f\"   - {error}\")\n    if len(errors) > 20:\n        print(f\"   ... and {len(errors) - 20} more\")","numLines":135,"startLine":700,"totalLines":1059}},"sourceToolAssistantUUID":"fdb53b52-784a-4763-a7ff-2a0951b8c0ea","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-vscode","cwd":"C:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit","sessionId":"05aa96e5-db7a-4aed-bad4-f0f3cebd2787","version":"2.1.312","gitBranch":"main"}
