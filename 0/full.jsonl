neither_routed_nor_linked():\n    from fastapi import FastAPI\n\n    from core.module_manager import ModuleManager\n\n    # A fresh app: other tests mount /brain onto the shared main.app, and routes persist.\n    fresh = FastAPI()\n    manager = ModuleManager(app=fresh)\n    manager.load_enabled_modules()\n    brain_routes = [r for r in fresh.routes if getattr(r, \"path\", \"\").startswith(\"/brain\")]\n\n    assert manager.modules[\"brain\"][\"enabled\"] is False\n    assert brain_routes == []\n    with TestClient(app) as client:\n        navbar = client.get(\"/navbar\")\n    assert 'href=\"/brain/ui\"' not in navbar.text\n","structuredPatch":[{"oldStart":39,"oldLines":4,"newStart":39,"newLines":8,"lines":["     assert brain_routes == []","     with TestClient(app) as client:","         navbar = client.get(\"/navbar\")","-    assert 'href=\"/brain/ui\"' not in navbar.text","+    # ADR-067 (operator request): the disabled brain stays visible so it can be started, but","+    # only through a link that enables the module first; it is still not routed until then.","+    brain_links = re.findall(r'<a href=\"/brain/ui\"[^>]*>', navbar.text)","+    assert brain_links and all(\"data-enable-brain\" in link for link in brain_links)","+    assert \"/modules/brain/enable\" in navbar.text"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"f5e8ef2e-f532-4d6f-9018-31cf1c9d9b1b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-vscode","cwd":"C:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\projects\\neurocore","sessionId":"05aa96e5-db7a-4aed-bad4-f0f3cebd2787","version":"2.1.312","gitBranch":"main"}
