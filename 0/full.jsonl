{"parentUuid":"b191044e-bc6f-41a3-8e9f-8c09161cc40c","isSidechain":false,"promptId":"5f9e5ff9-d388-44f3-b7f7-04295e73888a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013keLT3Ar43xrbfPYXmFYVU","type":"tool_result","content":"import assert from \"node:assert/strict\";\nimport os from \"node:os\";\nimport test from \"node:test\";\n\nimport { isLoopbackConnection, requiresApiAuth } from \"../src/http.js\";\nimport { makeHarness } from \"./helpers.js\";\n\nfunction lanAddress() {\n  return Object.values(os.networkInterfaces())\n    .flat()\n    .find((item) => item && item.family === \"IPv4\" && !item.internal)?.address ?? null;\n}\n\ntest(\"LAN auth covers /v1 and non-loopback /api routes\", () => {\n  const lan = { socket: { remoteAddress: \"192.168.1.40\" } };\n  const local = { socket: { remoteAddress: \"127.0.0.1\" } };\n  assert.equal(isLoopbackConnection(local), true);\n  assert.equal(isLoopbackConnection({ socket: { remoteAddress: \"::ffff:127.0.0.1\" } }), true);\n  assert.equal(isLoopbackConnection(lan), false);\n\n  assert.equal(requiresApiAuth(local, { requireAuth: true, pathname: \"/v1/models\" }), true);\n  assert.equal(requiresApiAuth(local, { requireAuth: true, pathname: \"/api/state\" }), false);\n  assert.equal(requiresApiAuth(lan, { requireAuth: true, pathname: \"/v1/models\" }), true);\n  assert.equal(requiresApiAuth(lan, { requireAuth: true, pathname: \"/api/state\" }), true);\n  assert.equal(requiresApiAuth(lan, { requireAuth: false, pathname: \"/api/state\" }), false);\n});\n\ntest(\"server settings clamp values and API keys verify once, then revoke\", async (t) => {\n  const harness = await makeHarness(t);\n  const updated = await harness.serverSettings.update({\n    port: 70000,\n    maxIdleTtlMinutes: 0,\n    enableCors: true,\n  });\n  assert.equal(updated.port, 65535);\n  assert.equal(updated.maxIdleTtlMinutes, 1);\n  assert.equal(updated.enableCors, true);\n\n  const created = await harness.serverSettings.createKey(\"test client\");\n  assert.match(created.key, /^mdk_/);\n  assert.equal(harness.serverSettings.verifyKey(created.key), true);\n  assert.equal(harness.serverSettings.verifyKey(\"mdk_wrong\"), false);\n  assert.equal(harness.serverSettings.listKeys().length, 1);\n\n  assert.equal(await harness.serverSettings.revokeKey(created.record.id), true);\n  assert.equal(harness.serverSettings.verifyKey(created.key), false);\n  assert.equal(harness.serverSettings.listKeys().length, 0);\n});\n\ntest(\"server settings endpoints expose keys without hashes\", async (t) => {\n  const harness = await makeHarness(t);\n  const response = await fetch(`${harness.base}/api/server-settings`);\n  assert.equal(response.status, 200);\n  const data = await response.json();\n  assert.equal(typeof data.settings.port, \"number\");\n  assert.deepEqual(data.apiKeys, []);\n\n  const created = await fetch(`${harness.base}/api/server-settings/api-keys`, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/json\" },\n    body: JSON.stringify({ label: \"laptop\" }),\n  }).then((item) => item.json());\n  assert.match(created.key, /^mdk_/);\n  assert.equal(created.record.label, \"laptop\");\n  assert.equal(created.record.hash, undefined);\n\n  const list = await fetch(`${harness.base}/api/server-settings`).then((item) => item.json());\n  assert.equal(list.activeKeys, 1);\n  assert.equal(list.apiKeys[0].hash, undefined);\n});\n\ntest(\"require-auth protects /v1 while the local UI stays reachable\", async (t) => {\n  const harness = await makeHarness(t);\n  await harness.serverSettings.update({ requireAuth: true });\n  const created = await harness.serverSettings.createKey(\"client\");\n\n  const denied = await fetch(`${harness.base}/v1/models`);\n  assert.equal(denied.status, 401);\n\n  const allowed = await fetch(`${harness.base}/v1/models`, {\n    headers: { authorization: `Bearer ${created.key}` },\n  });\n  assert.equal(allowed.status, 200);\n\n  const ui = await fetch(`${harness.base}/api/state`);\n  assert.equal(ui.status, 200);\n\n  const xKey = await fetch(`${harness.base}/v1/models`, {\n    headers: { \"x-api-key\": created.key },\n  });\n  assert.equal(xKey.status, 200);\n});\n\ntest(\"LAN auth blocks /api over a real non-loopback socket\", async (t) => {\n  const lan = lanAddress();\n  if (!lan) {\n    t.skip(\"no non-internal IPv4 address\");\n    return;\n  }\n  const harness = await makeHarness(t, { host: \"0.0.0.0\", baseHost: lan });\n  await harness.serverSettings.update({ requireAuth: true, serveOnLocalNetwork: true });\n  const created = await harness.serverSettings.createKey(\"lan client\");\n\n  let denied;\n  try {\n    denied = await fetch(`${harness.base}/api/state`);\n  } catch {\n    t.skip(\"LAN socket is unavailable (firewall or interface changed)\");\n    return;\n  }\n  assert.equal(denied.status, 401);\n\n  const allowed = await fetch(`${harness.base}/api/state`, {\n    headers: { \"x-api-key\": created.key },\n  });\n  assert.equal(allowed.status, 200);\n\n  const loopback = await fetch(`http://127.0.0.1:${harness.port}/api/state`);\n  assert.equal(loopback.status, 200);\n\n- **Decision**: Add `LlamaEngine.complete()` using `LlamaCompletion` with a fresh context sequence, the same one-generation guard, sampling settings, abort handling and manifest builder as chat. Add `POST /v1/completions` with non-streaming and SSE `text_completion` responses, single-string prompt validation, usage, finish reason and `system_fingerprint`. Chat remains on `LlamaChatSession`.\n- **Consequences**: Clients can use either OpenAI endpoint; completions still enter the same CPU queue and cannot overlap a chat. The completion manifest has no system prompt or history, so it records empty values plus the prompt/settings/model identity. Prompt arrays and token-ID arrays are rejected with an actionable error rather than silently misread.\r\n\n### ADR-014: Preserve actionable generation errors\n- **Date**: 2026-10-30\n- **Status**: Accepted\n- **Context**: Chat and text completion wrapped every thrown error in a generic generation failure, so a deliberate 413 context overflow or invalid-schema error reached clients as a 500. A failed LlamaCompletion constructor could also leave its context sequence undisposed.\n- **Decision**: Move the generation error mapping into `src/generation-error.js`. It returns an existing AppError unchanged and only wraps unexpected failures as 500 or 507 memory errors. `engine.chat` and `engine.complete` use it. If completion construction fails before the completion object exists, dispose the context sequence explicitly.\n- **Consequences**: API and SSE clients receive the original status, code, why and fix for actionable failures. Generic runtime failures keep the friendly message. Sequence memory is released on the constructor-failure path.\r\n\n### ADR-015: Single-model lookup and cached model listing\n- **Date**: 2026-10-30\n- **Status**: Accepted\n- **Context**: OpenAI clients expect `GET /v1/models/{id}`, and the list route rescanned the model folder on every request even though the registry already keeps a scan cache.\n- **Decision**: Serve `/v1/models` from `registry.listPublic()`, add `GET /v1/models/{id}` with id or file-name lookup and a 404 for unknown models, and return quant, size and chat-template hash alongside the standard OpenAI model fields.\n- **Consequences**: Model listing no longer touches disk on each request; a new model becomes visible after the normal registry refresh. Single-model lookups are cheap and unknown ids fail cleanly.\r\n\n### ADR-016: Release idle chat sequences before a completion\n- **Date**: 2026-10-30\n- **Status**: Accepted\n- **Context**: With the default `sequences=1`, a lingering UI chat session owns the only context sequence. A following `/v1/completions` request failed with \"No sequences left\", even though generation is serialized.\n- **Decision**: Before allocating a completion sequence, if `context.sequencesLeft` is zero, dispose idle chat sessions. A completion has no chat history to preserve, and the next chat turn rebuilds its session from the atomic store.\n- **Consequences**: Completions and chat can alternate with the default single sequence. Alternating endpoints loses the chat KV cache; the generation manifest remains exact because the rebuilt session uses the same bounded history.\r\n\n### ADR-017: Unify load and generation error mapping\n- **Date**: 2026-10-30\n- **Status**: Accepted\n- **Context**: ADR-014 preserved actionable generation errors, but model loading still wrapped GPU-backend and configuration AppErrors as generic model_load_failed 500s. Keeping two separate mappers also risked the same divergence.\n- **Decision**: Rename the mapper module to `src/engine-errors.js` and expose `toLoadError` alongside `toGenerationError`. Both return an existing AppError unchanged and only wrap unexpected failures into the friendly 500/507 messages for their operation.\n- **Consequences**: Explicit GPU-backend failures keep `gpu_backend_failed`, memory failures keep 507 codes, and unexpected load/generation failures stay friendly. The old `generation-error.js` was removed; ADR-014 remains as the historical generation-only decision.\r\n1346:    const data = await request(\"/api/server-settings\");\n1361:  els.serverLan.checked = Boolean(config.serveOnLocalNetwork);\n1362:  els.serverCors.checked = Boolean(config.enableCors);\n1563:    serveOnLocalNetwork: els.serverLan.checked,\n1566:    enableCors: els.serverCors.checked,\n1574:    const data = await request(\"/api/server-settings\", { method: \"PUT\", body: { settings: payload } });\n1580:      (previous.port !== data.settings.port || previous.serveOnLocalNetwork !== data.settings.serveOnLocalNetwork)\n1596:    const data = await request(\"/api/server-settings/api-keys\", {\n1623:    await request(`/api/server-settings/api-keys/${encodeURIComponent(key.id)}`, { method: \"DELETE\" });","is_error":false}]},"uuid":"c2c21ed2-3865-4c