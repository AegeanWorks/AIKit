{"parentUuid":"05fd8759-8db1-415b-bf7e-4342bd8ff31f","isSidechain":false,"promptId":"e576fa94-db77-402f-876f-969ab294b577","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YCbuqCK2e7DZeV61bKnmQp","type":"tool_result","content":"\"\"\"Cross-process locking and atomic JSON persistence shared by brain ledgers.\n\nEvery brain ledger is written by a request worker that may share the file with another worker\nor another process. A :class:`LedgerLock` combines a thread re-entrant guard with an OS file\nlock, and :func:`atomic_write_json` keeps the fsynced temp-file plus ``os.replace`` contract.\nEngines decorate their mutating methods with :func:`engine_transaction` so a writer reloads\nthe ledger, applies one change and persists it while no other writer holds the lock.\n\"\"\"\n\nimport functools\nimport json\nimport logging\nimport os\nimport tempfile\nimport threading\nfrom contextlib import contextmanager\nfrom typing import Any, Callable, Dict, Iterator, Optional\n\nfrom filelock import FileLock\n\nlogger = logging.getLogger(__name__)\n\nLOCK_TIMEOUT_SECONDS = 10.0\n\n\nclass LedgerLock:\n    \"\"\"Serialize access to one ledger across threads and processes.\"\"\"\n\n    def __init__(self, path: str, timeout: float = LOCK_TIMEOUT_SECONDS):\n        self.path = f\"{path}.lock\"\n        self.timeout = float(timeout)\n        self._thread_guard = threading.RLock()\n        self._file_lock = FileLock(self.path, timeout=self.timeout)\n        self._local = threading.local()\n\n    @property\n    def reentrant(self) -> bool:\n        \"\"\"Whether this thread already holds the lock (a nested engine call).\"\"\"\n        return getattr(self._local, \"depth\", 0) > 0\n\n    @contextmanager\n    def held(self) -> Iterator[None]:\n        with self._thread_guard:\n            with self._file_lock:\n                self._local.depth = getattr(self._local, \"depth\", 0) + 1\n                try:\n                    yield\n                finally:\n                    self._local.depth -= 1\n\n\ndef atomic_write_json(path: str, data: Dict[str, Any], *,\n                      default: Optional[Callable[[Any], Any]] = None) -> None:\n    \"\"\"Write JSON through a fsynced temp file and atomic replace; the caller holds the lock.\"\"\"\n    directory = os.path.dirname(os.path.abspath(path)) or \".\"\n    os.makedirs(directory, exist_ok=True)\n    fd, temp_path = tempfile.mkstemp(\n        prefix=os.path.basename(path) + \".\", suffix=\".tmp\", dir=directory\n    )\n    try:\n        with os.fdopen(fd, \"w\", encoding=\"utf-8\") as handle:\n            json.dump(data, handle, indent=2, default=default)\n            handle.flush()\n            os.fsync(handle.fileno())\n        os.replace(temp_path, path)\n    except Exception:\n        try:\n            os.remove(temp_path)\n        except OSError as exc:\n            logger.debug(\"Could not remove ledger temp file %s: %s\", temp_path, exc)\n        raise\n\n\n81:@router.get(\"\", response_class=HTMLResponse)\n93:@router.get(\"/gui\", response_class=HTMLResponse)\n99:@router.get(\"/list\", response_class=HTMLResponse)\n104:@router.post(\"/save\")\n162:@router.post(\"/{name}/toggle\")\n173:@router.delete(\"/{name}\")\n187:@router.get(\"/edit/{name}\")\n210:@router.get(\"/names\")\n216:@router.get(\"/with-descriptions\")\n230:@router.get(\"/definitions\")\n243:@router.get(\"/export\")\n283:@router.get(\"/config/{name}\", response_class=HTMLResponse)\n304:@router.post(\"/config/{name}\", response_class=HTMLResponse)\n357:@router.post(\"/import\")\ncore/module_manager.py:33:    fd, tmp_path = tempfile.mkstemp(prefix=\".module-\", suffix=\".tmp\",\ncore/module_manager.py:107:            module_prefix = f\"/{module_id}\"\ncore/module_manager.py:112:                    if route.path == module_prefix or route.path.startswith(module_prefix + \"/\"):\ncore/module_manager.py:118:                # wrapper, so the module's tags and prefix live in include_context\ncore/module_manager.py:124:                    prefix = getattr(context, \"prefix\", \"\") or \"\"","is_error":false}]},"uuid":"b13c6289-cd0a-41dd-a2a7-0bf07f0c252b","timestamp":"2026-10-29T19:57:21.177Z","toolUseResult":{"stdout":"\"\"\"Cross-process locking and atomic JSON persistence shared by brain ledgers.\n\nEvery brain ledger is written by a request worker that may share the file with another worker\nor another process. A :class:`LedgerLock` combines a thread re-entrant guard with an OS file\nlock, and :func:`atomic_write_json` keeps the fsynced temp-file plus ``os.replace`` contract.\nEngines decorate their mutating methods with :func:`engine_transaction` so a writer reloads\nthe ledger, applies one change and persists it while no other writer holds the lock.\n\"\"\"\n\nimport functools\nimport json\nimport logging\nimport os\nimport tempfile\nimport threading\nfrom contextlib import contextmanager\nfrom typing import Any, Callable, Dict, Iterator, Optional\n\nfrom filelock import FileLock\n\nlogger = logging.getLogger(__name__)\n\nLOCK_TIMEOUT_SECONDS = 10.0\n\n\nclass LedgerLock:\n    \"\"\"Serialize access to one ledger across threads and processes.\"\"\"\n\n    def __init__(self, path: str, timeout: float = LOCK_TIMEOUT_SECONDS):\n        self.path = f\"{path}.lock\"\n        self.timeout = float(timeout)\n        self._thread_guard = threading.RLock()\n        self._file_lock = FileLock(self.path, timeout=self.timeout)\n        self._local = threading.local()\n\n    @property\n    def reentrant(self) -> bool:\n        \"\"\"Whether this thread already holds the lock (a nested engine call).\"\"\"\n        return getattr(self._local, \"depth\", 0) > 0\n\n    @contextmanager\n    def held(self) -> Iterator[None]:\n        with self._thread_guard:\n            with self._file_lock:\n                self._local.depth = getattr(self._local, \"depth\", 0) + 1\n                try:\n                    yield\n                finally:\n                    self._local.depth -= 1\n\n\ndef atomic_write_json(path: str, data: Dict[str, Any], *,\n                      default: Optional[Callable[[Any], Any]] = None) -> None:\n    \"\"\"Write JSON through a fsynced temp file and atomic replace; the caller holds the lock.\"\"\"\n    directory = os.path.dirname(os.path.abspath(path)) or \".\"\n    os.makedirs(directory, exist_ok=True)\n    fd, temp_path = tempfile.mkstemp(\n        prefix=os.path.basename(path) + \".\", suffix=\".tmp\", dir=directory\n    )\n    try:\n        with os.fdopen(fd, \"w\", encoding=\"utf-8\") as handle:\n            json.dump(data, handle, indent=2, default=default)\n            handle.flush()\n            os.fsync(handle.fileno())\n        os.replace(temp_path, path)\n    except Exception:\n        try:\n            os.remove(temp_path)\n        except OSError as exc:\n            logger.debug(\"Could not remove ledger temp file %s: %s\", temp_path, exc)\n        raise\n\n\n81:@router.get(\"\", response_class=HTMLResponse)\n93:@router.get(\"/gui\", response_class=HTMLResponse)\n99:@router.get(\"/list\", response_class=HTMLResponse)\n104:@router.post(\"/save\")\n162:@router.post(\"/{name}/toggle\")\n173:@router.delete(\"/{name}\")\n187:@router.get(\"/edit/{name}\")\n210:@router.get(\"/names\")\n216:@router.get(\"/with-descriptions\")\n230:@router.get(\"/definitions\")\n243:@router.get(\"/export\")\n283:@router.get(\"/config/{name}\", response_class=HTMLResponse)\n304:@router.post(\"/config/{name}\", response_class=HTMLResponse)\n357:@router.post(\"/import\")\ncore/module_manager.py:33:    fd, tmp_path = tempfile.mkstemp(prefix=\".module-\", suffix=\".tmp\",\ncore/module_manager.py:107:            module_prefix = f\"/{module_id}\"\ncore/module_manager.py:112:                    if route.path == module_prefix or route.path.startswith(module_prefix + \"/\"):\ncore/module_manager.py:118:                # wrapper, so the module's tags and prefix live in include_context\ncore/module_manager.py:124:                    prefix = g