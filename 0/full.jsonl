                    code = \"\"\n                    if os.path.exists(code_path):\n                        with open(code_path, \"r\", encoding=\"utf-8\") as f:\n                            code = f.read()\n                    \n                    # Execute tool code in sandboxed environment for security\n                    # Use run_in_executor to avoid blocking the event loop\n                    spend(\"tool_calls\")\n                    try:\n                        loop = asyncio.get_running_loop()\n                        result = await loop.run_in_executor(\n                            None,\n                            self.sandbox.execute,\n                            code,\n                            {\"args\": args}\n                        )\n                        output = result.get(\"result\", \"Success (no result returned)\")\n                    except SecurityError as e:\n                        output = f\"Security Error: Tool '{func_name}' violated security policy: {str(e)}\"\n                    except ResourceLimitError as e:\n                        output = f\"Resource Limit Error: Tool '{func_name}' exceeded resource limits: {str(e)}\"\n                    except TimeoutError as e:\n                        output = f\"Timeout Error: Tool '{func_name}' took too long to execute: {str(e)}\"\n                    except Exception as e:\n                        output = f\"Error executing tool {func_name}: {str(e)}\"\n            else:\n                output = f\"Error: Tool {func_name} not found in library.\"\n\n            # Tool output is untrusted: redact credential-shaped text before it reaches\n            # the conversation (ADR-054).\n            guard = scan_output(str(output))\n            if guard.redactions:\n                output = guard.text\n\n            results.append({\n                \"tool_call_id\": tool_call[\"id\"],\n                \"role\": \"tool\",\n                \"name\": func_name,\n                \"content\": str(output)\n            })\n\n        # Update the conversation history if provided\n        messages = []\n        if \"messages\" in input_data:\n            messages = list(input_data[\"messages\"])\n            messages.append(message)\n            messages.extend(results)\n\n        return {\n            \"tool_results\": results,\n            \"assistant_message\": message,\n            \"messages\": messages,\n            \"requires_continuation\": has_remaining,\n        }\n\n    async def send(self, processed_data: dict) -> dict:\n        return processed_data\n\nasync def get_executor_class(node_type_id: str):\n    if node_type_id == \"tool_dispatcher\":\n        return ToolDispatcherExecutor\n    return None\n","structuredPatch":[{"oldStart":7,"oldLines":7,"newStart":7,"newLines":7,"lines":[" from .outbound import stage_if_outbound"," from .sandbox import ToolSandbox, SecurityError, ResourceLimitError, TimeoutError"," from core.execution_budget import spend","-from modules.brain.guardrails import scan_output, wrap_untrusted","+from modules.brain.guardrails import scan_output"," "," logger = logging.getLogger(__name__)"," "]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"sourceToolAssistantUUID":"af3dac41-525b-4e03-af17-19b1e6babd82","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-vscode","cwd":"C:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\projects\\neurocore","sessionId":"05aa96e5-db7a-4aed-bad4-f0f3cebd2787","version":"2.1.312","gitBranch":"main"}
