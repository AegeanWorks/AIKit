bg-slate-800 text-xs\">Mute 1h</button>\n            </div>\n        </div>`;\n    }\n\n    function render() {\n        if (!lastState) return;\n        const state = lastState.state || {};\n        const self = lastState.self || {};\n        const kernel = self.kernel || state.last_snapshot?.kernel || {};\n        const reactivity = self.reactivity || {};\n        $('kernel-mode').textContent = String(kernel.mode || '—').toUpperCase();\n        $('kernel-risk').textContent = `risk ${kernel.risk_score ?? 0} · ${kernel.reason || ''}`;\n        $('health').textContent = String(self.health || '—').toUpperCase();\n        $('health').className = `text-2xl font-bold ${self.health === 'ok' ? 'text-emerald-400' : 'text-amber-400'}`;\n        $('confidence').textContent = `confidence ${self.confidence ?? '—'}`;\n        $('cycles').textContent = state.cycle_count ?? 0;\n        $('throttle').textContent = state.throttled ? 'throttled' : (state.last_error ? `error: ${state.last_error}` : '');\n        $('reaction-count').textContent = reactivity.reactions ?? 0;\n        $('reactivity-state').textContent = reactivity.running ? `polling · ${reactivity.pending || 0} pending` : 'polling off';\n        $('proposals').innerHTML = (state.proposals || []).map(renderProposal).join('') || '<p class=\"text-slate-500\">No proposals.</p>';\n        const evaluation = self.evaluation || {};\n        $('eval-result').textContent = Object.keys(evaluation).length ? JSON.stringify(evaluation, null, 2) : 'No evaluation loaded.';\n    }\n\n    async function refresh() {\n        try {\n            lastState = await request('/brain/state');\n            const reactions = await request('/brain/reactions');\n            render();\n            $('reactions').innerHTML = (reactions.items || []).slice(0, 20).map(renderReaction).join('') || '<p class=\"text-slate-500\">No reactions.</p>';\n            showError('');\n        } catch (error) {\n            showError(error.message);\n        }\n    }\n\n    async function action(name) {\n        try {\n            if (name === 'start') await request('/brain/start', {method: 'POST'});\n            else if (name === 'stop') await request('/brain/stop', {method: 'POST'});\n            else if (name === 'cycle') await request('/brain/cycle', {method: 'POST'});\n            else if (name === 'kill') await request('/brain/kernel/kill', {method: 'POST', body: JSON.stringify({reason: 'dashboard'})});\n            else if (name === 'reset') await request('/brain/kernel/reset', {method: 'POST'});\n            else if (name === 'react-start') await request('/brain/react/start', {method: 'POST'});\n            else if (name === 'react-stop') await request('/brain/react/stop', {method: 'POST'});\n            else if (name === 'react-poll') await request('/brain/react/poll', {method: 'POST'});\n            else if (name === 'eval-run') await request('/brain/eval/run', {method: 'POST', body: '{}'});\n            else if (name === 'eval-baseline') await request('/brain/eval/baseline', {method: 'POST'});\n            window.showToast?.('Brain action completed', 'success');\n            await refresh();\n        } catch (error) {\n            showError(error.message);\n        }\n    }\n\n    document.addEventListener('click', async (event) => {\n        const actionButton = event.target.closest('[data-action]');\n        if (actionButton) { await action(actionButton.dataset.action); return; }\n        const dismiss = event.target.closest('[data-dismiss]');\n        if (dismiss) {\n            try { await request('/brain/reactions/dismiss', {method: 'POST', body: JSON.stringify({reaction_id: dismiss.dataset.dismiss})}); await refresh(); }\n            catch (error) { showError(error.message); }\n            return;\n        }\n        const mute = event.target.closest('[data-mute]');\n        if (mute) {\n            try { await request('/brain/reactions/mute', {method: 'POST', body: JSON.stringify({key: mute.dataset.mute, minutes