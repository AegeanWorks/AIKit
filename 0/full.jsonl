 len(MEDIA_MARKER_END)\n730\t            text = text[:start] + block.rstrip(\"\\n\") + text[end:]\n731\t        else:\n732\t            lines = text.splitlines(keepends=True)\n733\t            at = next((index + 1 for index, line in enumerate(lines) if line.startswith(\"# \")), 0)\n734\t            text = \"\".join(lines[:at]) + \"\\n\" + block + \"\".join(lines[at:])\n735\t    if shot_block:\n736\t        if SHOT_MARKER_START in text and SHOT_MARKER_END in text:\n737\t            start = text.index(SHOT_MARKER_START)\n738\t            end = text.index(SHOT_MARKER_END) + len(SHOT_MARKER_END)\n739\t            text = text[:start] + shot_block.strip(\"\\n\") + text[end:]\n740\t        else:\n741\t            text = text.rstrip(\"\\n\") + \"\\n\" + shot_block\n742\t    elif SHOT_MARKER_START in text and SHOT_MARKER_END in text:\n743\t        start = text.index(SHOT_MARKER_START)\n744\t        end = text.index(SHOT_MARKER_END) + len(SHOT_MARKER_END)\n745\t        text = text[:start].rstrip(\"\\n\") + \"\\n\" + text[end:].lstrip(\"\\n\")\n746\t    # An older banner line would duplicate the single social preview. Remove legacy banner embeds\n747\t    # outside our marker, leaving ordinary prose that merely mentions a banner untouched.\n748\t    lines = []\n749\t    for line in text.splitlines(keepends=True):\n750\t        stripped = line.strip()\n751\t        if ((\"banner.\" in stripped and (stripped.startswith(\"<img\") or stripped.startswith(\"![\")))\n752\t                or (\"banner.\" in stripped and stripped.startswith(\"<p\"))):\n753\t            continue\n754\t        if stripped in {f\"*{ASSET_DISCLOSURE}*\", ASSET_DISCLOSURE,\n755\t                        \"*Brand assets are generated and may not fully represent the project scope.*\",\n756\t                        \"*The banner and logo are AI-generated brand assets. They are illustrative \"\n757\t                        \"and may not literally depict every feature or the full project scope.*\",\n758\t                        AIKIT_BADGE, AIKIT_INTEGRATED_BADGE}:"}]},"uuid":"5ed68437-d5de-400f-92b9-40b39d3cad7f","timestamp":"2026-10-29T19:15:16.904Z","toolUseResult":{"type":"text","file":{"filePath":"c:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\scripts\\project_media.py","content":"def _update_readme(readme: Path, repo: str, data: Dict[str, object],\n                   shots: Sequence[Dict[str, object]]) -> None:\n    text = readme.read_text(encoding=\"utf-8\")\n    assets = data.get(\"assets\") or {}\n    pieces = []\n    if _approved(assets.get(\"social_preview\")):\n        social_src = str(assets[\"social_preview\"].get(\"path\") or \"assets/social-preview.png\").replace(\"\\\\\", \"/\")\n        pieces.append(f'<p align=\"center\"><img src=\"{social_src}\" '\n                      f'alt=\"{repo} social preview\" width=\"100%\"></p>')\n        badges = _badge_row(readme.parent, repo)\n        if badges:\n            pieces.append(badges)\n    block = \"\"\n    if pieces:\n        block = f\"{MEDIA_MARKER_START}\\n\" + \"\\n\".join(pieces) + f\"\\n{MEDIA_MARKER_END}\\n\"\n    shot_block = \"\"\n    if shots:\n        cells = []\n        for shot in shots:\n            cells.append(\n                f'<a href=\"https://github.com/AegeanWorks/{repo}/commit/{shot[\"commit\"]}\">'\n                f'<img src=\"assets/screenshots/{Path(shot[\"src\"]).name}\" '\n                f'alt=\"{xml_escape(shot[\"alt\"])}\"></a>\\n\\n'\n                f'*commit `{shot[\"commit\"]}` · {shot[\"taken_at\"]}*'\n            )\n        shot_block = (f\"\\n{SHOT_MARKER_START}\\n## Screenshots\\n\\n\" + \"\\n\\n\".join(cells)\n                      + f\"\\n{SHOT_MARKER_END}\\n\")\n    if block:\n        if MEDIA_MARKER_START in text and MEDIA_MARKER_END in text:\n            start = text.index(MEDIA_MARKER_START)\n            end = text.index(MEDIA_MARKER_END) + len(MEDIA_MARKER_END)\n            text = text[:start] + block.rstrip(\"\\n\") + text[end:]\n        else:\n            lines = text.splitlines(keepends=True)\n            at = next((index + 1 for index, line in enumerate(lines) if line.startswith(\"# \")), 0)\n            text = \"\".join(lines[:at]) + \"\\n\" + block + \"\".join(lines[at:])\n    if shot_block:\n        if SHOT_MARKER_START in text and SHOT_MARKER_END in text:\n            start = text.index(SHOT_MARKER_START)\n            end = text.index(SHOT_MARKER_END) + len(SHOT_MARKER_END)\n            text = text[:start] + shot_block.strip(\"\\n\") + text[end:]\n        else:\n            text = text.rstrip(\"\\n\") + \"\\n\" + shot_block\n    elif SHOT_MARKER_START in text and SHOT_MARKER_END in text:\n        start = text.index(SHOT_MARKER_START)\n        end = text.index(SHOT_MARKER_END) + len(SHOT_MARKER_END)\n        text = text[:start].rstrip(\"\\n\") + \"\\n\" + text[end:].lstrip(\"\\n\")\n    # An older banner line would duplicate the single social preview. Remove legacy banner embeds\n    # outside our marker, leaving ordinary prose that merely mentions a banner untouched.\n    lines = []\n    for line in text.splitlines(keepends=True):\n        stripped = line.strip()\n        if ((\"banner.\" in stripped and (stripped.startswith(\"<img\") or stripped.startswith(\"![\")))\n                or (\"banner.\" in stripped and stripped.startswith(\"<p\"))):\n            continue\n        if stripped in {f\"*{ASSET_DISCLOSURE}*\", ASSET_DISCLOSURE,\n                        \"*Brand assets are generated and may not fully represent the project scope.*\",\n                        \"*The banner and logo are AI-generated brand assets. They are illustrative \"\n                        \"and may not literally depict every feature or the full project scope.*\",\n                        AIKIT_BADGE, AIKIT_INTEGRATED_BADGE}:","numLines":60,"startLine":699,"totalLines":850}},"sourceToolAssistantUUID":"ba36c62c-2089-4825-9d5e-acfda402ff9d","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"externa