eld] = value\n1089\t        if status != \"Superseded\":\n1090\t            # A stale replacement pointer on an idea that is no longer superseded would tell a\n1091\t            # reader to follow a decision that has been reversed.\n1092\t            idea.pop(\"superseded_by\", None)\n1093\t        if target and target != idea.get(\"target\"):\n1094\t            # Bind the re-route to the *dossier's* target, not the current one, so routing back\n1095\t            # to the original analysis is representable: it simply clears the marker.\n1096\t            current_target = str(idea.get(\"target\", \"\"))\n1097\t            history = list(idea.get(\"history\", []) or [])\n1098\t            history.append(\n1099\t                _history_entry(\n1100\t                    field=\"target\",\n1101\t                    before=current_target,\n1102\t                    after=target,\n1103\t                    by=decided_by,\n1104\t                    at=decided_at or datetime.date.today().isoformat(),\n1105\t                    reason=reason,\n1106\t                )\n1107\t            )\n1108\t            idea[\"history\"] = history\n1109\t            if declared and target == declared:\n1110\t                idea.pop(\"retargeted_from\", None)\n1111\t            else:\n1112\t                idea[\"retargeted_from\"] = declared or current_target\n1113\t            idea[\"target\"] = target\n1114\t        errors = validate_idea(idea, target_ids(targets), sources)\n1115\t        if errors:\n1116\t            raise RegistryError(\"; \".join(errors))\n1117\t        ideas[position] = idea\n1118\t        payload[\"ideas\"] = ideas\n1119\t        write_json(root / IDEAS_FILE, payload)\n1120\t        return idea\n1121\t\n1122\t\n1123\t# ---------------------------------------------------------------------------\n1124\t# Automatic registration from commit references\n1125\t# ---------------------------------------------------------------------------\n1126\t\n1127\tCOMMIT_IDEA_RE = r