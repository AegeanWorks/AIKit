\"--ref\" in argv:\n        index = argv.index(\"--ref\")\n        if index + 1 >= len(argv) or argv[index + 1].startswith(\"-\"):\n            print(\"[INVALID USAGE] --ref requires a commit.\", file=sys.stderr)\n            print(\"Why: there is no sensible default other than HEAD, which is already the default.\",\n                  file=sys.stderr)\n            print(\"Fix: pass '--ref <commit>', or omit it to verify HEAD.\", file=sys.stderr)\n            sys.exit(2)\n        target = argv[index + 1]\n\n    print(\"=\" * 58)\n    print(\"POST-COMMIT VERIFICATION (PRINCIPLE-018 R7)\")\n    print(\"=\" * 58)\n    if \"--verbose\" in argv or \"-v\" in argv:\n        print(f\"Secret scan range: {unpushed_range(ROOT_DIR, target, run_command)}\")\n    exit_code, lines = verify_commit(target)\n    stream = sys.stdout if exit_code == 0 else sys.stderr\n    for line in lines:\n        print(line, file=stream)\n    print(\"=\" * 58, file=stream)\n    sys.exit(exit_code)\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"fbb3ed37-50de-48e1-be6f-1bf4df78f377","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-vscode","cwd":"C:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit","sessionId":"07a11155-9f67-48dd-9986-2d892e5f4e3f","version":"2.1.302","gitBranch":"main","slug":"eager-humming-wave"}
