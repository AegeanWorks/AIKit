handing one back whenever no upstream resolved scanned the whole history,\n    which stays red forever over a key already revoked (ADR-133, ADR-149).\n    \"\"\"\n    head = run([\"git\", \"rev-parse\", ref], repo)[1].strip()\n    code, upstream = run([\"git\", \"rev-parse\", f\"{ref}@{{u}}\"], repo)\n    upstream = upstream.strip() if code == 0 else \"\"\n    if upstream and upstream != head:\n        return f\"{upstream}..{head}\"\n    code, parent = run([\"git\", \"rev-parse\", f\"{ref}^\"], repo)\n    parent = parent.strip() if code == 0 else \"\"\n    return f\"{parent}..{head}\" if parent else head"}},"serverClassifierRequest":"b9738453-4e8e-4f05-885b-a68be386d56e","apiBlockIndex":0,"requestId":"req_011CgBrgP1zUJjdDkPBUWpNK","requestRef":"dbd06395-6f2e-4bd7-a63d-425c874ff716","requestedModel":"claude-opus-5","type":"assistant","uuid":"8116a147-3679-4198-8bd4-eb8c298932ee","timestamp":"2026-10-19T15:47:25.452Z","advisorModel":"claude-opus-5-5","effort":"medium","perTurnEffort":null,"userType":"external","entrypoint":"claude-vscode","cwd":"C:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit","sessionId":"07a11155-9f67-48dd-9986-2d892e5f4e3f","version":"2.1.302","gitBranch":"main","slug":"eager-humming-wave"}
