SystemExit: return\r\n     1 typed except -> Pass       e.g. primordia\\web.py:289 except KeyboardInterrupt: pass\r\nTALLY: 7 single-statement handlers, 7 unannotated\r\n     4 typed except -> Return     e.g. tally\\storage.py:56 except OSError: return\r\n     3 typed except -> Pass       e.g. tally\\storage.py:163 except OSError: pass\r\nVOIDFARER: 14 single-statement handlers, 14 unannotated\r\n    10 typed except -> Pass       e.g. voidfarer\\cli.py:19 except (ValueError, OSError): pass\r\n     4 typed except -> Return     e.g. voidfarer\\engine.py:893 except ValueError: return","is_error":false}]}}
