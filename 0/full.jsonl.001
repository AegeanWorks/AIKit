ption_recovery.py --workspace projects/modelduck --checkpoint live-tune --agent claude-opus-5.5 --phase verification --phase-num 4 --desc \"[1/2] live summary and stream in; [2/2] live sections in the panel. Milestone 1: tests pass, gate 4/4; checklists: passed\" --why \"The user wants running tunes shown in real time with sections under the tuner\" --benefits \"A running tune shows its progress, what it tries and what it decides as it happens\" --risks \"contract: new GET /api/tune/stream and scheduler subscribe; dependency: none; concurrency: listeners per open page; state: none\" --mitigation \"Failing-first scheduler and server tests; polling fallback; ADR-055\" | tail -1 && MSG='feat(tune): [milestone 1/2] stream a running tune'\"'\"'s live summary\n\nThe scheduler keeps each model'\"'\"'s answers, time left, the setting being\ntried and the decisions so far, and GET /api/tune/stream pushes every\nchange to the page as it happens (ADR-055).\n\nCo-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>' && python scripts/disruption_recovery.py --validate-commit \"$MSG\" >/dev/null || exit 1; cd projects/modelduck && git add src/tune-scheduler.js src/server.js tests/tune-scheduler.test.js tests/server.test.js .aikit/decisions.md .aikit/task_ledger.json && git commit -q -m \"$MSG\" && git log --oneline -1 && git status --short && cd ../.. && python aikit.py ui begin modelduck --surface app 2>&1 | tail -1","description":"Add ADR-055, gate, commit milestone 1 and open the UI task","timeout":600000},"caller":{"type":"direct"}}]}}
