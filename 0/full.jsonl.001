Duck's own\" };","+","+/** The suite's tasks and question types, fetched once (ADR-058). */","+async function loadBenchSuite() {","+  if (state.benchSuite) return;","+  try {","+    state.benchSuite = await request(\"/api/benchmarks/suite\");","+    renderBenchSuite(state.benchSuite);","+  } catch (error) {","+    showError(error);","+  }","+}","+","+function renderBenchSuite(suite) {","+  const heldShare = Math.round(suite.holdoutShare * 100);","+  const intro = Object.assign(document.createElement(\"p\"), {","+    className: \"bench-suite-total\",","+    textContent: `Suite version ${suite.suiteVersion}: ${suite.items} questions in ${suite.tasks.length} tasks. About ${heldShare}% of every question type is held back.`,","+  });","+  els.benchSuite.replaceChildren(intro);","+  for (const task of suite.tasks) {","+    const section = document.createElement(\"section\");","+    section.className = \"bench-suite-task\";","+    section.appendChild(Object.assign(document.createElement(\"h4\"), { textContent: `${TASK_NAMES[task.id] ?? task.label} — ${task.items} questions` }));","+    section.appendChild(Object.assign(document.createElement(\"p\"), {","+      className: \"tune-intro\",","+      textContent: `Tuned on ${task.tunedOn}, in rounds of ${task.rungs.join(\", \")} questions; ${task.held} held back.`,","+    }));","+    const table = document.createElement(\"table\");","+    table.className = \"benchmark-table\";","+    const head = table.createTHead().insertRow();","+    for (const text of [\"Question type\", \"Questions\", \"Held back\", \"From\", \"Checked by\"]) head.appendChild(Object.assign(document.createElement(\"th\"), { textContent: text }));","+    const body = table.createTBody();","+    for (const type of task.types) {","+      body.insertRow().append(","+        tuneCell(TYPE_NAMES[type.category] ?? type.category),","+        tuneCell(String(type.items)),","+        tuneCell(String(type.held)),","+        tuneCell(type.sources.map((source) => SOURCE_NAMES[source] ?? source).join(\", \")),","+        tuneCell(type.checks.map((check) => CHECK_NAMES[check] ?? check).join(\", \")),","+      );","+    }","+    section.appendChild(table);","+    els.benchSuite.appendChild(section);","+  }","+}","+"," const rightOf = (entry, key) => (entry ? `${entry[key]} of ${entry.items}` : \"–\");"," "," /** Right answers per question type for every task: preset against defaults, tuned and unseen (ADR-056). */"]},{"oldStart":2677,"oldLines":6,"newStart":2734,"newLines":7,"lines":["     // A private window keeps the tab for this visit only.","   }","   if (chosen === \"runs\") void loadTuneRuns();","+  if (chosen === \"suite\") void loadBenchSuite();"," }"," "," function renderTuneLive(job) {"]}]},{"filePath":"C:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\projects\\modelduck\\public\\index.html","hunks":[{"oldStart":469,"oldLines":6,"newStart":469,"newLines":7,"lines":["           <button class=\"bench-tab\" type=\"button\" role=\"tab\" id=\"bench-tab-models\" data-bench-tab=\"models\" aria-controls=\"bench-panel-models\" aria-selected=\"false\">Models</button>","           <button class=\"bench-tab\" type=\"button\" role=\"tab\" id=\"bench-tab-runs\" data-bench-tab=\"runs\" aria-controls=\"bench-panel-runs\" aria-selected=\"false\">Runs</button>","           <button class=\"bench-tab\" type=\"button\" role=\"tab\" id=\"bench-tab-settings\" data-bench-tab=\"settings\" aria-controls=\"bench-panel-settings\" aria-selected=\"false\">Tune settings</button>","+          <button class=\"bench-tab\" type=\"button\" role=\"tab\" id=\"bench-tab-suite\" data-bench-tab=\"suite\" aria-controls=\"bench-panel-suite\" aria-selected=\"false\">Benchmark</button>","           <button class=\"bench-tab\" type=\"button\" role=\"tab\" id=\"bench-tab-gate\" data-bench-tab=\"gate\" aria-controls=\"bench-panel-gate\" aria-selected=\"false\">Benchmark gate</button>","         </div>","         <section class=\"benchmark-run bench-panel\" id=\"bench-panel-tune\" role=\"tabpanel\" aria-labelledby=\"bench-tab-tune\" data-bench-panel=\"tune\">"]},{"oldStart":527,"oldLines":6,"newStart":528,"newLines":10,"lines":["             <p class=\"benchmark-progress\" id=\"tune-settings-note\">Lists are comma-separated. Values outside what the app accepts are dropped and listed here.</p>","           </div>","         </section>","+        <section class=\"benchmark-run bench-panel\" id=\"bench-panel-suite\" role=\"tabpanel\" aria-labelledby=\"bench-tab-suite\" data-bench-panel=\"suite\" hidden>","+          <p class=\"tune-intro\">What the tuner asks each model: every task's question types, where the questions come from, how answers are checked, and how many are held back to check a preset on questions it was never tuned on.</p>","+          <div class=\"bench-suite\" id=\"bench-suite\"></div>","+        </section>","         <section class=\"bench-panel benchmark-reports\" id=\"benchmark-reports\" role=\"tabpanel\" aria-labelledby=\"bench-tab-gate\" data-bench-panel=\"gate\" hidden>","           <p class=\"tune-intro\">The full benchmark run and the statistics of earlier runs. Not needed for tuning.</p>","           <label class=\"check benchmark-show-old\">"]}]},{"filePath":"C:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\projects\\modelduck\\public\\styles.css","hunks":[{"oldStart":2973,"oldLines":3,"newStart":2973,"newLines":18,"lines":[" .tune-type-worse td {","   color: var(--danger, #f87171);"," }","+","+/* The Benchmark tab: the suite per task */","+.bench-suite-total {","+  margin: 0 0 8px;","+  font-size: 13px;","+}","+","+.bench-suite-task {","+  margin-top: 14px;","+}","+","+.bench-suite-task h4 {","+  margin: 0 0 2px;","+  font-size: 13px;","+}"]}]}],"moreFiles":0,"changedFiles":["C:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\projects\\modelduck\\public\\app.js","C:\\Users\\Yunus-Emre\\Desktop\\portable_agent_kit\\projects\\modelduck\\public\\index.html","C:\\Users\\Yunus-Emre\\Desktop\\portable_agent_