ut) === JSON.stringify(c.expect);\",\n    \"    return { ok, detail: ok ? 'ok' : 'got ' + JSON.stringify(out) };\",\n    \"  } catch (error) { return { ok: false, detail: 'threw ' + String(error && error.message) }; }\",\n    \"});\",\n    `process.stdout.write(\"\\\\n${RESULT_MARKER}\" + JSON.stringify(__results));`,\n  ].join(\"\\n\");\n  const outcome = await new Promise((resolve) => {\n    execFile(\n      process.execPath,\n      [\"--permission\", \"-e\", harness],\n      { timeout: timeoutMs, windowsHide: true, maxBuffer: 1024 * 1024 },\n      (error, stdout) => resolve({ error, stdout: String(stdout ?? \"\") }),\n    );\n  });\n699:export function extractCode(text, entry = null) {\n700-  const blocks = [...String(text ?? \"\").matchAll(/```[\\w-]*\\s*\\n([\\s\\S]*?)```/g)].map((match) => match[1]);\n701-  const defines = entry ? new RegExp(`\\\\bfunction\\\\s+${entry}\\\\b|\\\\b(?:const|let|var)\\\\s+${entry}\\\\s*=`) : null;\n702-  const chosen = (defines && blocks.filter((block) => defines.test(block)).at(-1)) ?? blocks[0];\n703-  return (chosen ?? stripFence(String(text ?? \"\"))).trim();\n704-}\n705-\n706-const RESULT_MARKER = \"__MODELDUCK_TEST_RESULTS__\";\n707-\n708-/**\n709- * Runs generated JavaScript against test cases in a child process started with\n710- * `node --permission` and no allow flags: file, child-process, worker and\n711- * network access are all denied, and a timeout kills runaway code. Returns one\n712- * check per case so a partly correct function earns partial credit.\n713- */\n714-export async function runJavaScriptTests(text, check, { timeoutMs = 5000 } = {}) {\n715-  const { execFile } = await import(\"node:child_process\");\n716-  const cases = check.cases ?? [];\n717-  const code = extractCode(text, check.entry);\n718-  const named = new RegExp(`\\\\b${check.entry}\\\\b`).test(code);\n719-  const harness = [\n720-    // The rest of a codebase item's files; the answer comes after, so its functions replace theirs.\n721-    check