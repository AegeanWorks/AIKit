s/benchmark-suite-v11.test.js:5:import { PROMPTS, SUITE_VERSION, runJavaScriptTests } from \"../benchmarks/suite.mjs\";\ntests/benchmark-suite-v11.test.js:129:  const results = await runJavaScriptTests(`\\`\\`\\`js\\n${REFERENCE.heaviestLine}\\n\\`\\`\\``, item.checks[0]);\ntests/benchmark-suite-v6.test.js:4:import { PROMPTS, SMOKE_PROMPT_IDS, checkCount, evaluateTextCheck, runJavaScriptTests } from \"../benchmarks/suite.mjs\";\n35:  assert.equal(evaluateTextCheck({ type: \"choice\", value: \"B\" }, \"I am not sure.\").unreadable, true);\n36:  assert.equal(evaluateTextCheck({ type: \"number\", value: 15 }, \"fifteen\").unreadable, true);\n37:  assert.equal(evaluateTextCheck({ type: \"choice\", value: \"B\" }, \"Answer: A\").unreadable, false);\n38:  assert.equal(evaluateTextCheck({ type: \"number\", value: 15 }, \"Answer: 16\").unreadable, false);\n48:test(\"a whole reply is unreadable when a check found nothing to read, and the code check says so when the function is missing\", async () => {","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"17c1a596-1fec-41a8-8e61-30d1bb83a1e8","context":{"git_state":{"cwd":"/c/Users/Yunus-Emre/Desktop/portable_agent_kit/projects/modelduck","root":"/c/Users/Yunus-Emre/Desktop/portable_agent_kit/projects/modelduck","branch":"master","default_branch":null,"status":{"clean":false,"counts":{"staged":0,"modified":2,"untracked":null,"untracked_normal":1},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"AegeanWorks/Modelduck","visibility":"private"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"AegeanWorks/Modelduck","visibility":"private"}],"visibility_cache":[{"host":"github.com","remote":"AegeanWorks/AIKit","visibility":"public"},{"host":"github.com","remote":"AegeanWorks/Modelduck","visibility":"private"}]}},"live_cwd":"/c/Users/Yunus-Emre/Desktop/portable_agent_kit/projects/modelduck","platform":"